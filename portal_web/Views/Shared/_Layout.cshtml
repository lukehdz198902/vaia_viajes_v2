@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaia Viajes - @(ViewBag.Title ?? "Portal")</title>
    <link rel="icon" type="image/svg+xml" href="https://cdn-icons-png.flaticon.com/512/3095/3095583.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('vaia-theme');
                var theme = (stored === 'light' || stored === 'dark')
                    ? stored
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link href="~/css/tokens.css?v=2" rel="stylesheet" />
    <link href="~/css/base.css?v=2" rel="stylesheet" />
    <link href="~/css/animations.css?v=2" rel="stylesheet" />
    <link href="~/css/components.css?v=2" rel="stylesheet" />
    <link href="~/css/layout.css?v=2" rel="stylesheet" />
    <link href="~/css/responsive.css?v=2" rel="stylesheet" />
    <link href="~/css/legacy.css?v=2" rel="stylesheet" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app-shell" id="appShell">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <button class="sidebar-toggle" id="btnToggleSidebar" title="Toggle sidebar">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="brand-text">
                    <i class="fas fa-car-side"></i>
                    <span class="brand-name">Vaia Viajes</span>
                </div>
            </div>
            <nav class="sidebar-nav" id="sidebarNav">
                <div class="nav-section-label">Principal</div>
                <a href="@Url.Action("Index", "Home")" class="nav-item"><i class="fas fa-th-large"></i><span>Dashboard</span></a>
                <a href="@Url.Action("Usuarios", "Home")" class="nav-item"><i class="fas fa-user-shield"></i><span>Usuarios</span></a>
                <a href="@Url.Action("Pasajeros", "Home")" class="nav-item"><i class="fas fa-users"></i><span>Pasajeros</span></a>
                <a href="@Url.Action("Conductores", "Home")" class="nav-item"><i class="fas fa-id-card"></i><span>Conductores</span></a>
                <a href="@Url.Action("Servicios", "Home")" class="nav-item"><i class="fas fa-route"></i><span>Servicios</span></a>

                <div class="nav-section-label">Gestion</div>
                <a href="@Url.Action("Reportes", "Home")" class="nav-item"><i class="fas fa-chart-bar"></i><span>Reportes</span></a>
                <a href="@Url.Action("Incidentes", "Home")" class="nav-item"><i class="fas fa-exclamation-triangle"></i><span>Incidentes</span></a>
                <a href="@Url.Action("Promociones", "Home")" class="nav-item"><i class="fas fa-tags"></i><span>Promociones</span></a>
                <a href="@Url.Action("Zonas", "Home")" class="nav-item"><i class="fas fa-map-marked-alt"></i><span>Zonas</span></a>
                <a href="@Url.Action("Cortes", "Home")" class="nav-item"><i class="fas fa-money-bill-wave"></i><span>Cortes</span></a>

                <div class="nav-section-label">Sistema</div>
                <a href="@Url.Action("Configuracion", "Home")" class="nav-item"><i class="fas fa-cog"></i><span>Configuracion</span></a>
                <a href="@Url.Action("Compania", "Home")" class="nav-item"><i class="fas fa-building"></i><span>Compania</span></a>
                <a href="@Url.Action("Notificaciones", "Home")" class="nav-item"><i class="fas fa-bell"></i><span>Notificaciones</span></a>
                <a href="@Url.Action("Avisos", "Home")" class="nav-item"><i class="fas fa-bullhorn"></i><span>Avisos</span></a>
                <a href="@Url.Action("Auditoria", "Home")" class="nav-item"><i class="fas fa-history"></i><span>Auditoria</span></a>
            </nav>
            <div class="sidebar-footer">
                <div class="user-mini" id="userMini">
                    <div class="avatar" id="userAvatar">AD</div>
                    <div class="user-info-text">
                        <div class="user-name" id="userName">Admin</div>
                        <div class="user-role" id="userRole">--</div>
                    </div>
                </div>
                <button type="button" class="theme-toggle" data-vaia-theme-toggle aria-label="Cambiar tema" aria-pressed="false" title="Cambiar tema">
                    <i class="fas fa-moon" data-theme-icon></i>
                </button>
                <a href="@Url.Action("Logout", "Home")" class="logout-btn" title="Cerrar sesion">
                    <i class="fas fa-sign-out-alt"></i>
                </a>
            </div>
        </aside>

        <main class="main-area" id="mainArea">
            <header class="topbar">
                <button class="mobile-toggle" id="btnMobileToggle"><i class="fas fa-bars"></i></button>
                <div class="page-title" id="pageTitle">@(ViewBag.Title ?? "Dashboard")</div>
                <div class="topbar-actions">
                    <button class="topbar-btn" id="btnNotif" title="Notificaciones">
                        <i class="fas fa-bell"></i>
                        <span class="notif-dot"></span>
                    </button>
                    <div class="user-dropdown">
                        <div class="topbar-user" id="topbarUser">
                            <div class="avatar-sm" id="topbarAvatar">AD</div>
                            <span class="user-label" id="topbarName">Admin</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>
                </div>
            </header>
            <div class="content-area" id="contentArea">
                @RenderBody()
            </div>
        </main>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="~/Scripts/core/vaia-theme.js"></script>
    <script src="~/Scripts/core/vaia-ui.js"></script>
    @Html.Partial("_VaiaConfig")
    <script>
        (function () {
            var usr = sessionStorage.getItem('usr_id');
            if (!usr) { window.location.href = '@Url.Action("Login", "Home")'; return; }

            var nombre = sessionStorage.getItem('usr_nombre') || 'Admin';
            var account = sessionStorage.getItem('usr_account') || '';
            var rol = sessionStorage.getItem('usr_rol') || '';
            var iniciales = nombre ? nombre.charAt(0).toUpperCase() : 'A';
            if (nombre.indexOf(' ') > -1) iniciales = nombre.charAt(0) + nombre.charAt(nombre.indexOf(' ')+1);
            iniciales = iniciales.toUpperCase().substring(0,2);

            $('#userName, #topbarName').text(nombre);
            $('#userRole').text(rol);
            $('#userAvatar, #topbarAvatar').text(iniciales);

            var path = window.location.pathname.toLowerCase();
            $('#sidebarNav .nav-item').each(function () {
                var href = $(this).attr('href').toLowerCase();
                if (path === href || (href !== '/home/login' && path.startsWith(href))) $(this).addClass('active');
            });

            var $sidebar = $('#sidebar'),
                $overlay = $('#sidebarOverlay'),
                $shell = $('#appShell'),
                $body = $('body');

            function isMobile() { return window.matchMedia('(max-width: 900px)').matches; }

            $('#btnToggleSidebar').on('click', function (e) {
                e.stopPropagation();
                if (isMobile()) {
                    $sidebar.toggleClass('open');
                    $overlay.toggleClass('is-visible', $sidebar.hasClass('open'));
                } else {
                    $shell.toggleClass('collapsed');
                }
            });

            $('#btnMobileToggle').on('click', function () {
                $sidebar.addClass('open');
                $overlay.addClass('is-visible');
            });

            $overlay.on('click', function () {
                $sidebar.removeClass('open');
                $overlay.removeClass('is-visible');
            });

            var hoverTimer;
            $sidebar.on('mouseenter', function () {
                if ($shell.hasClass('collapsed') && !isMobile()) {
                    clearTimeout(hoverTimer);
                    $shell.addClass('expanding');
                }
            }).on('mouseleave', function () {
                if ($shell.hasClass('collapsed') && !isMobile()) {
                    hoverTimer = setTimeout(function () { $shell.removeClass('expanding'); }, 200);
                }
            });

            $('.logout-btn').on('click', function (e) {
                e.preventDefault();
                AdminApp.confirm('Cerrar sesion', 'Esta seguro de cerrar la sesion?', function () {
                    sessionStorage.clear();
                    window.location.href = '/Home/Login';
                });
            });

            function syncOnResize() {
                if (isMobile()) {
                    $shell.removeClass('collapsed');
                    $sidebar.removeClass('open');
                    $overlay.removeClass('is-visible');
                }
            }
            window.addEventListener('resize', syncOnResize);
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
