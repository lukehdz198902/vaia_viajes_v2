@{
    ViewBag.Title = "Incidentes";
}

@section Styles {
    <link href="~/css/pages/incidentes.css?v=2" rel="stylesheet" />
}

<div class="list-page" id="dvIncidentes">

    <header class="page-header">
        <div>
            <h2 class="page-header__title">Incidentes</h2>
            <p class="page-header__subtitle">Reportes generados desde la app y su seguimiento</p>
        </div>
        <div class="page-header__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="btnReloadIncidentes">
                <i class="fas fa-rotate"></i> Recargar
            </button>
        </div>
    </header>

    <div class="inc-filter-bar">
        <div class="form-field">
            <label class="form-label" for="txtFi">Fecha inicio</label>
            <input type="date" class="form-input" id="txtFi" />
        </div>
        <div class="form-field">
            <label class="form-label" for="txtFf">Fecha fin</label>
            <input type="date" class="form-input" id="txtFf" />
        </div>
        <div class="form-field">
            <label class="form-label" for="selTipo">Tipo</label>
            <select class="form-select" id="selTipo">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="form-field">
            <label class="form-label" for="selEstatus">Estatus</label>
            <select class="form-select" id="selEstatus">
                <option value="">Todos</option>
            </select>
        </div>
        <div class="inc-filter-bar__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="btnLimpiarFiltros" title="Limpiar filtros">
                <i class="fas fa-undo"></i> Limpiar filtros
            </button>
        </div>
    </div>

    <div class="config-summary">
        <i class="fas fa-circle-info"></i>
        <span id="lblResumenIncidentes">Cargando...</span>
    </div>

    <div class="card">
        <div id="dvTablaIncidentes" class="card-body" style="padding-top:0;"></div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        window.VaiaIncidentes = (function () {
            var DATA = [];
            var state = { pagina: 1, tamano: 50 };

            function getVal(obj, key) {
                if (!obj || !key) return undefined;
                var k = key.toLowerCase();
                for (var p in obj) {
                    if (p.toLowerCase() === k) return obj[p];
                }
                return undefined;
            }

            function escapeHtml(s) {
                if (s == null) return '';
                return String(s).replace(/[&<>"']/g, function (m) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
                });
            }

            function fmtDate(s) {
                if (!s) return '--';
                var d = new Date(s);
                if (isNaN(d)) return '--';
                return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' }) +
                       ' ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
            }

            function statusClass(estatus) {
                var e = (estatus || '').toLowerCase().replace(/\s+/g, '');
                if (e.indexOf('reportado') >= 0) return 'inc-status--reportado';
                if (e.indexOf('investigacion') >= 0) return 'inc-status--eninvestigacion';
                if (e.indexOf('resuelto') >= 0) return 'inc-status--resuelto';
                if (e.indexOf('cerrado') >= 0) return 'inc-status--cerrado';
                if (e.indexOf('cancelado') >= 0) return 'inc-status--cancelado';
                return '';
            }

            function cargarCatalogos() {
                AdminApp.ajax('admin/TiposIncidente', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                    var $sel = $('#selTipo').empty().append('<option value="">Todos</option>');
                    data.forEach(function (t) {
                        $sel.append('<option value="' + (getVal(t, 'id') || '') + '">' + escapeHtml(getVal(t, 'nombre') || getVal(t, 'nombretipo') || '--') + '</option>');
                    });
                }, function () { if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudieron cargar los tipos de incidente' }); });

                AdminApp.ajax('admin/EstatusIncidente', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                    var $sel = $('#selEstatus').empty().append('<option value="">Todos</option>');
                    data.forEach(function (e) {
                        $sel.append('<option value="' + (getVal(e, 'id') || '') + '">' + escapeHtml(getVal(e, 'nombre') || getVal(e, 'nombreestatus') || '--') + '</option>');
                    });
                }, function () { if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudieron cargar los estatus' }); });
            }

            function cargarIncidentes() {
                var $dv = $('#dvTablaIncidentes');
                $dv.html('<div class="skeleton skeleton--block" style="height:200px;"></div>');
                var params = { pagina: state.pagina, tamano: state.tamano };
                var fi = $('#txtFi').val(); if (fi) params.fi = fi;
                var ff = $('#txtFf').val(); if (ff) params.ff = ff;
                var idTipo = $('#selTipo').val(); if (idTipo) params.idTipoIncidente = parseInt(idTipo, 10);
                var idEst = $('#selEstatus').val(); if (idEst) params.idEstatus = parseInt(idEst, 10);

                AdminApp.ajax('admin/ListarIncidentes', 'GET', params, function (res) {
                    var data = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                    var total = getVal(res, 'totalregistros') || data.length;
                    DATA = data.map(function (r) {
                        return {
                            id: getVal(r, 'idIncidente') || getVal(r, 'id'),
                            tipo: getVal(r, 'tipo') || getVal(r, 'nombretipo') || '--',
                            servicio: getVal(r, 'servicio') || (getVal(r, 'idservicio') ? '#' + getVal(r, 'idservicio') : '--'),
                            descripcion: getVal(r, 'descripcion') || getVal(r, 'descripcionincidente') || '',
                            estatus: getVal(r, 'estatus') || getVal(r, 'nombreestatus') || '--',
                            fecha: getVal(r, 'fecha') || getVal(r, 'fechaincidente')
                        };
                    });
                    renderTabla();
                    $('#lblResumenIncidentes').text(DATA.length + ' de ' + total + ' incidentes');
                }, function () {
                    $dv.html('<div class="empty-state"><div class="empty-state__icon"><i class="fas fa-triangle-exclamation"></i></div><h4 class="empty-state__title">No se pudieron cargar los incidentes</h4><p class="empty-state__message">Verifica la conexion con el servidor e intenta de nuevo.</p></div>');
                    if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudieron cargar los incidentes' });
                });
            }

            function renderTabla() {
                if (!DATA.length) {
                    $('#dvTablaIncidentes').html('<div class="empty-state"><div class="empty-state__icon"><i class="fas fa-circle-check"></i></div><h4 class="empty-state__title">Sin incidentes</h4><p class="empty-state__message">No hay incidentes registrados en el periodo seleccionado.</p></div>');
                    return;
                }
                var html = '<div class="data-table-wrap"><table class="data-table inc-table"><thead><tr>';
                html += '<th class="col-id">ID</th><th class="col-tipo">Tipo</th><th>Servicio</th><th class="col-desc">Descripcion</th><th class="col-status">Estatus</th><th>Fecha</th><th class="col-actions"></th>';
                html += '</tr></thead><tbody>';
                DATA.forEach(function (r) {
                    html += '<tr>';
                    html += '  <td class="col-id">#' + r.id + '</td>';
                    html += '  <td class="col-tipo">' + escapeHtml(r.tipo) + '</td>';
                    html += '  <td>' + escapeHtml(r.servicio) + '</td>';
                    html += '  <td class="col-desc" title="' + escapeHtml(r.descripcion) + '">' + escapeHtml(r.descripcion) + '</td>';
                    html += '  <td class="col-status"><span class="inc-status ' + statusClass(r.estatus) + '"><span class="dot"></span>' + escapeHtml(r.estatus) + '</span></td>';
                    html += '  <td>' + fmtDate(r.fecha) + '</td>';
                    html += '  <td class="col-actions"><button class="btn btn--ghost btn--icon btn--sm" data-action="ver" data-id="' + r.id + '" title="Ver detalle"><i class="fas fa-eye"></i></button><button class="btn btn--ghost btn--icon btn--sm" data-action="estatus" data-id="' + r.id + '" title="Cambiar estatus"><i class="fas fa-arrows-rotate"></i></button></td>';
                    html += '</tr>';
                });
                html += '</tbody></table></div>';
                $('#dvTablaIncidentes').html(html);
            }

            function verDetalle(id) {
                AdminApp.ajax('admin/DetalleIncidente', 'GET', { idIncidente: id }, function (res) {
                    var main = Array.isArray(res) ? res[0] : res;
                    var historial = Array.isArray(res) && res.length > 1 ? res[1] : (Array.isArray(res) ? [] : (res && res.historial ? res.historial : []));

                    if (!main || !main.idIncidente) {
                        if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se encontro el incidente' });
                        return;
                    }

                    var body = '<div class="inc-detail-grid">' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Tipo</span><span class="inc-detail-item__value">' + escapeHtml(getVal(main, 'tipo') || '--') + '</span></div>' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Estatus actual</span><span class="inc-detail-item__value"><span class="inc-status ' + statusClass(getVal(main, 'estatus')) + '"><span class="dot"></span>' + escapeHtml(getVal(main, 'estatus') || '--') + '</span></span></div>' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Servicio vinculado</span><span class="inc-detail-item__value">' + (getVal(main, 'idservicio') ? '#' + getVal(main, 'idservicio') : '--') + '</span></div>' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Conductor</span><span class="inc-detail-item__value">' + escapeHtml(getVal(main, 'conductor') || '--') + '</span></div>' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Pasajero</span><span class="inc-detail-item__value">' + escapeHtml(getVal(main, 'pasajero') || '--') + '</span></div>' +
                        '<div class="inc-detail-item"><span class="inc-detail-item__label">Fecha</span><span class="inc-detail-item__value">' + fmtDate(getVal(main, 'fecha')) + '</span></div>' +
                        '<div class="inc-detail-item" style="grid-column:1/-1;"><span class="inc-detail-item__label">Descripcion</span><span class="inc-detail-item__value">' + escapeHtml(getVal(main, 'descripcion') || '--') + '</span></div>' +
                        (getVal(main, 'so') ? '<div class="inc-detail-item"><span class="inc-detail-item__label">Sistema operativo</span><span class="inc-detail-item__value">' + escapeHtml(getVal(main, 'so')) + '</span></div>' : '') +
                        '</div>' +
                        '<h4 style="margin:0 0 var(--space-3);font-size:var(--text-md);"><i class="fas fa-clock-rotate-left" style="color:var(--accent);margin-right:6px;"></i>Historial de seguimiento</h4>' +
                        (historial && historial.length ?
                            '<div class="timeline-list">' + historial.map(function (h) {
                                return '<div class="timeline-step"><div class="timeline-step__dot"><i class="fas fa-circle-check"></i></div><div class="timeline-step__body"><div class="timeline-step__title">' + escapeHtml(getVal(h, 'estatus') || getVal(h, 'nombreestatus') || '--') + '</div><div class="timeline-step__meta">' + fmtDate(getVal(h, 'fecha') || getVal(h, 'fechacreacion')) + '</div>' + (getVal(h, 'comentarios') ? '<div class="timeline-step__comment">' + escapeHtml(getVal(h, 'comentarios')) + '</div>' : '') + '</div></div>';
                            }).join('') + '</div>'
                            : '<p style="color:var(--text-muted);text-align:center;padding:var(--space-4);">Sin historial de cambios.</p>');

                    window.VaiaUI.modal({
                        title: '<i class="fas fa-circle-exclamation" style="color:var(--state-warning);margin-right:8px;"></i>Detalle del incidente #' + getVal(main, 'idIncidente'),
                        titleHtml: true,
                        body: body,
                        fullscreen: true,
                        footer: '<button type="button" class="btn btn--ghost" data-close>Cerrar</button>'
                    });
                }, function () {
                    if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudo cargar el detalle del incidente' });
                });
            }

            function cambiarEstatus(id) {
                AdminApp.ajax('admin/EstatusIncidente', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                    var opciones = data.map(function (e) {
                        return '<option value="' + (getVal(e, 'id') || '') + '">' + escapeHtml(getVal(e, 'nombre') || getVal(e, 'nombreestatus') || '--') + '</option>';
                    }).join('');

                    var body = '<input type="hidden" id="vaiaIncId" value="' + id + '">' +
                        '<div class="form-field" style="margin-bottom:var(--space-3);">' +
                        '  <label class="form-label" for="vaiaIncEstatus">Nuevo estatus <span class="required-mark">*</span></label>' +
                        '  <select class="form-select" id="vaiaIncEstatus">' + opciones + '</select>' +
                        '</div>' +
                        '<div class="form-field">' +
                        '  <label class="form-label" for="vaiaIncComentarios">Comentarios (opcional)</label>' +
                        '  <textarea class="form-textarea" id="vaiaIncComentarios" rows="3" placeholder="Describe el avance o accion tomada..."></textarea>' +
                        '</div>';

                    var m = window.VaiaUI.modal({
                        title: '<i class="fas fa-arrows-rotate" style="color:var(--accent);margin-right:8px;"></i>Cambiar estatus del incidente',
                        titleHtml: true,
                        body: body,
                        fullscreen: true,
                        footer:
                            '<button type="button" class="btn btn--ghost" data-close>Cancelar</button>' +
                            '<button type="button" class="btn btn--primary" id="vaiaIncGuardar"><i class="fas fa-save"></i> Actualizar</button>'
                    });

                    $('#vaiaIncGuardar').on('click', function () {
                        var idEstatus = $('#vaiaIncEstatus').val();
                        var comentarios = $('#vaiaIncComentarios').val();
                        if (!idEstatus) { window.VaiaUI.toast({ type: 'warning', title: 'Selecciona estatus' }); return; }
                        AdminApp.ajax('admin/ActualizarEstatusIncidente', 'POST', {
                            idIncidente: id,
                            idUsuario: AdminApp.getUser().id,
                            idEstatus: idEstatus,
                            comentarios: comentarios
                        }, function () {
                            window.VaiaUI.toast({ type: 'success', title: 'Estatus actualizado' });
                            m.close();
                            cargarIncidentes();
                        });
                    });
                }, function () {
                    if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudieron cargar los estatus' });
                });
            }

            function initEventos() {
                $('#txtFi, #txtFf, #selTipo, #selEstatus').on('change', function () { state.pagina = 1; cargarIncidentes(); });
                $('#btnLimpiarFiltros').on('click', function () {
                    $('#txtFi, #txtFf, #selTipo, #selEstatus').val('');
                    state.pagina = 1;
                    cargarIncidentes();
                });
                $('#btnReloadIncidentes').on('click', cargarIncidentes);
                $('#dvTablaIncidentes').on('click', '[data-action]', function () {
                    var id = $(this).data('id');
                    if ($(this).data('action') === 'ver') verDetalle(id);
                    else if ($(this).data('action') === 'estatus') cambiarEstatus(id);
                });
            }

            return { init: function () { cargarCatalogos(); initEventos(); cargarIncidentes(); } };
        })();

        $(document).ready(function () { window.VaiaIncidentes.init(); });
    </script>
}