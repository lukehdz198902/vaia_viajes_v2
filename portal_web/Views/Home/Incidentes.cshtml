@{
    ViewBag.Title = "Incidentes";
}

@section Styles {
    <link href="~/Content/css/admin.css" rel="stylesheet" />
    <style>
        .history-item { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border-color); }
        .history-item:last-child { border-bottom: none; }
        .history-item .h-time { font-size: 0.75rem; color: var(--text-muted); min-width: 100px; }
        .history-item .h-status { font-weight: 500; font-size: 0.85rem; }
        .history-item .h-comment { font-size: 0.82rem; color: var(--text-muted); }
    </style>
}

<div id="dvIncidentes">
    <div class="section-header">
        <h4><i class="fas fa-exclamation-triangle"></i> Incidentes</h4>
    </div>

    <div class="card-custom">
        <div class="card-body-custom">
            <div class="filters-row">
                <div class="search-box" style="width:200px;">
                    <i class="fas fa-calendar"></i>
                    <input type="date" class="input-soft" id="txtFi" />
                </div>
                <div class="search-box" style="width:200px;">
                    <i class="fas fa-calendar"></i>
                    <input type="date" class="input-soft" id="txtFf" />
                </div>
                <select class="input-soft" id="selTipo"><option value="">Tipo</option></select>
                <select class="input-soft" id="selEstatus"><option value="">Estatus</option></select>
                <button class="btn-soft primary" onclick="Incidentes.filtrar()"><i class="fas fa-search"></i> Buscar</button>
                <button class="btn-soft outline" onclick="Incidentes.limpiarFiltros()"><i class="fas fa-undo"></i> Limpiar</button>
            </div>
        </div>
    </div>

    <div class="card-custom mt-3">
        <div class="card-body-custom p-0">
            <div class="table-wrap">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>Servicio</th>
                            <th>Descripcion</th>
                            <th>Estatus</th>
                            <th>Fecha</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbIncidentes"></tbody>
                </table>
            </div>
            <div class="pagination-wrap" id="dvPaginador"></div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalViewIncidente" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2" style="color:var(--primary);"></i>Detalle del Incidente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid" id="dvDetalleIncidente"></div>
                <hr />
                <h6 class="mb-3"><i class="fas fa-history me-2" style="color:var(--primary);"></i>Historial de Estatus</h6>
                <div id="dvHistorialIncidente"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalStatusIncidente" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exchange-alt me-2" style="color:var(--primary);"></i>Cambiar Estatus</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="txtStatusIdIncidente" />
                <div class="form-group mb-3">
                    <label>Estatus</label>
                    <select class="input-soft" id="selNuevoEstatus"></select>
                </div>
                <div class="form-group mb-3">
                    <label>Comentarios</label>
                    <textarea class="input-soft" id="txtStatusComentarios" rows="3" placeholder="Comentarios..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft primary" onclick="Incidentes.guardarEstatus()"><i class="fas fa-save"></i> Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        var Incidentes = (function () {
            var state = { pagina: 1, tamano: 20 };

            function cargar() {
                var fi = $('#txtFi').val(), ff = $('#txtFf').val();
                var idTipo = $('#selTipo').val(), idEst = $('#selEstatus').val();
                AdminApp.ajax('admin/ListarIncidentes', 'GET', { idEst, idTipo, fi, ff, pagina: state.pagina, tamano: state.tamano }, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var total = res.totalregistros || res.total || data.length;
                    renderTabla(data);
                    $('#dvPaginador').html(AdminApp.paginador(total, state.pagina, state.tamano, function (p) { state.pagina = p; cargar(); }));
                });
            }

            function renderTabla(data) {
                var h = '';
                if (!data.length) { h = '<tr><td colspan="7"><div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>No hay incidentes</p></div></td></tr>'; }
                else { data.forEach(function (r) {
                    h += '<tr><td>' + AdminApp.getVal(r, 'idIncidente') + '</td><td>' + AdminApp.getVal(r, 'tipo') + '</td><td>' + AdminApp.getVal(r, 'servicio') + '</td><td>' + AdminApp.getVal(r, 'descripcion') + '</td><td>' + AdminApp.getVal(r, 'estatus') + '</td><td>' + AdminApp.fmtFecha(r.fecha) + '</td><td class="accion-cell"><button class="view" title="Ver" onclick="Incidentes.ver(' + AdminApp.getVal(r, 'idIncidente') + ')"><i class="fas fa-eye"></i></button><button class="edit" title="Cambiar Estatus" onclick="Incidentes.cambiarEstatus(' + AdminApp.getVal(r, 'idIncidente') + ')"><i class="fas fa-exchange-alt"></i></button></td></tr>';
                }); }
                $('#tbIncidentes').html(h);
            }

            function ver(id) {
                AdminApp.ajax('admin/DetalleIncidente', 'GET', { idIncidente: id }, function (r) {
                    var d = r;
                    var h = '';
                    h += '<div class="detail-group"><span class="label">Tipo</span><span class="value">' + AdminApp.getVal(d, 'tipo') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Descripcion</span><span class="value">' + AdminApp.getVal(d, 'descripcion') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Servicio Vinculado</span><span class="value">' + AdminApp.getVal(d, 'servicio') + ' (ID: ' + AdminApp.getVal(d, 'idServicio') + ')</span></div>';
                    h += '<div class="detail-group"><span class="label">Conductor</span><span class="value">' + AdminApp.getVal(d, 'conductor') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Pasajero</span><span class="value">' + AdminApp.getVal(d, 'pasajero') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Fecha</span><span class="value">' + AdminApp.fmtFecha(d.fecha) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Estatus Actual</span><span class="value">' + AdminApp.getVal(d, 'estatus') + '</span></div>';
                    $('#dvDetalleIncidente').html(h);

                    var historial = d.historial || d.historialEstatus || [];
                    var hh = '';
                    if (!historial.length) { hh = '<p class="text-muted">Sin historial</p>'; }
                    else { historial.forEach(function (hst) {
                        hh += '<div class="history-item"><div class="h-time">' + AdminApp.fmtFecha(hst.fecha) + '</div><div><div class="h-status">' + AdminApp.getVal(hst, 'estatus') + '</div><div class="h-comment">' + AdminApp.getVal(hst, 'comentarios') + '</div></div></div>';
                    }); }
                    $('#dvHistorialIncidente').html(hh);
                    AdminApp.openModal('modalViewIncidente');
                });
            }

            function cambiarEstatus(id) {
                $('#txtStatusIdIncidente').val(id);
                AdminApp.ajax('admin/ListaIncidentesTablas', 'GET', null, function (res) {
                    var estatusList = Array.isArray(res) ? res : (res.estatus || []);
                    AdminApp.loadSelect('admin/ListaIncidentesTablas', 'selNuevoEstatus', 'id', 'nombre', null, true);
                    function loadEstatus() {
                        var $sel = $('#selNuevoEstatus'); $sel.html('<option value="">-- Seleccionar --</option>');
                        if (Array.isArray(estatusList)) { estatusList.forEach(function (e) { $sel.append('<option value="' + (e.id || e.idEstatus) + '">' + (e.nombre || e.estatus) + '</option>'); }); }
                    }
                    if (!Array.isArray(estatusList)) {
                        AdminApp.ajax('admin/ListaIncidentesTablas', 'GET', null, function (r2) {
                            estatusList = r2.estatus || r2;
                            loadEstatus();
                        });
                    } else { loadEstatus(); }
                });
                $('#txtStatusComentarios').val('');
                AdminApp.openModal('modalStatusIncidente');
            }

            function guardarEstatus() {
                var id = $('#txtStatusIdIncidente').val();
                var idEstatus = $('#selNuevoEstatus').val();
                var comentarios = $('#txtStatusComentarios').val();
                if (!idEstatus) { Toast.warning('Seleccione un estatus'); return; }
                AdminApp.ajax('admin/ActualizarEstatusIncidente', 'POST', { idIncidente: id, idUsuario: 1, idEstatus: idEstatus, comentarios: comentarios }, function () {
                    Toast.success('Estatus actualizado');
                    AdminApp.closeModal('modalStatusIncidente');
                    cargar();
                });
            }

            function filtrar() { state.pagina = 1; cargar(); }
            function limpiarFiltros() { $('#txtFi, #txtFf, #selTipo, #selEstatus').val(''); state.pagina = 1; cargar(); }

            function init() {
                AdminApp.loadSelect('admin/TiposIncidente', 'selTipo', 'id', 'nombre');
                AdminApp.ajax('admin/ListaIncidentesTablas', 'GET', null, function (res) {
                    var estatusList = Array.isArray(res) ? res : (res.estatus || []);
                    var $sel = $('#selEstatus');
                    if (Array.isArray(estatusList)) { estatusList.forEach(function (e) { $sel.append('<option value="' + (e.id || e.idEstatus) + '">' + (e.nombre || e.estatus) + '</option>'); }); }
                });
                cargar();
            }

            return { init: init, cargar: cargar, filtrar: filtrar, limpiarFiltros: limpiarFiltros, ver: ver, cambiarEstatus: cambiarEstatus, guardarEstatus: guardarEstatus };
        })();
        $(document).ready(function () { Incidentes.init(); });
    </script>
}
