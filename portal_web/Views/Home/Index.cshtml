@{
    ViewBag.Title = "Dashboard";
}

@section Styles {
    <link href="~/css/pages/dashboard.css" rel="stylesheet" />
}

<div class="dashboard" id="dvDashboard">
    <div class="page-header">
        <div>
            <h2 class="page-header__title">Dashboard</h2>
            <p class="page-header__subtitle">Resumen operativo en tiempo real</p>
        </div>
        <div class="page-header__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="btnRefreshDashboard" title="Actualizar">
                <i class="fas fa-rotate"></i> Actualizar
            </button>
        </div>
    </div>

    <section class="kpi-grid vaia-stagger" id="dvStatsCards" aria-label="Indicadores clave"></section>

    <section class="chart-grid">
        <article class="chart-card">
            <header class="chart-card__header">
                <div>
                    <h3 class="chart-card__title">Ingresos</h3>
                    <p class="chart-card__subtitle" id="lblPeriodo">Ultimos 7 dias</p>
                </div>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn--ghost btn--sm" data-period="semana">Semana</button>
                    <button type="button" class="btn btn--ghost btn--sm" data-period="mes">Mes</button>
                </div>
            </header>
            <div class="chart-card__canvas">
                <canvas id="chartIngresos"></canvas>
            </div>
        </article>

        <article class="chart-card">
            <header class="chart-card__header">
                <div>
                    <h3 class="chart-card__title">Actividad reciente</h3>
                    <p class="chart-card__subtitle">Ultimos eventos del sistema</p>
                </div>
            </header>
            <div class="activity-list" id="dvActividad"></div>
        </article>
    </section>

    <article class="card">
        <header class="card-header">
            <div>
                <h3 class="card-title">Ultimos servicios</h3>
                <p class="card-subtitle">Servicios registrados en los ultimos 7 dias</p>
            </div>
            <div class="input-icon toolbar__search">
                <i class="fas fa-search input-icon__icon"></i>
                <input type="text" class="form-input" id="txtBuscarServicio" placeholder="Buscar servicio..." aria-label="Buscar servicio" />
            </div>
        </header>
        <div id="dvTablaServicios" class="card-body" style="padding-top: 0;"></div>
    </article>
</div>

@section Scripts {
    <script src="~/Scripts/Home/Index/fn.js"></script>
    <script src="~/Scripts/Home/Index/jnAjax.js"></script>
    <script src="~/Scripts/Home/Index/Initscript.js"></script>
}