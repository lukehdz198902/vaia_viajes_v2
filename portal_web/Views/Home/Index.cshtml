@{
    ViewBag.Title = "Dashboard";
}

@section Styles {
    <link href="~/Scripts/Views/Home/Index/style.css" rel="stylesheet" />
}

<div id="dvDashboard">
    <div class="row g-4 mb-4" id="dvStatsCards"></div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card-custom">
                <div class="card-header-custom">
                    <h6><i class="fas fa-chart-area me-2" style="color: var(--primary);"></i>Ingresos Semanales</h6>
                    <div class="d-flex gap-2">
                        <button class="btn-soft outline btn-sm" onclick="window.cambiarPeriodo('semana')">Semana</button>
                        <button class="btn-soft outline btn-sm" onclick="window.cambiarPeriodo('mes')">Mes</button>
                    </div>
                </div>
                <div class="card-body-custom">
                    <canvas id="chartIngresos" height="280"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card-custom">
                <div class="card-header-custom">
                    <h6><i class="fas fa-clock me-2" style="color: var(--secondary);"></i>Actividad Reciente</h6>
                </div>
                <div class="card-body-custom">
                    <div class="timeline" id="dvTimeline"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12">
            <div class="card-custom">
                <div class="card-header-custom">
                    <h6><i class="fas fa-list me-2" style="color: var(--accent);"></i>Ultimos Servicios</h6>
                    <div class="search-box" style="width: 280px;">
                        <i class="fas fa-search"></i>
                        <input type="text" class="input-soft" id="txtBuscarServicio" placeholder="Buscar servicio..." />
                    </div>
                </div>
                <div class="card-body-custom p-0">
                    <div id="dvTablaServicios"><div class="loader" style="margin: 40px auto;"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Views/Home/Index/fn.js"></script>
    <script src="~/Scripts/Views/Home/Index/jnAjax.js"></script>
    <script src="~/Scripts/Views/Home/Index/Initscript.js"></script>
}
