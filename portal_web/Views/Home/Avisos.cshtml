@{
    ViewBag.Title = "Avisos en App";
}

@section Styles {
    <link href="~/css/admin.css" rel="stylesheet" />
}

<div id="dvAvisos">
    <div class="section-header">
        <h4><i class="fas fa-exclamation-triangle"></i> Avisos en App</h4>
        <button class="btn-soft primary" onclick="AvisosApp.abrirNuevo()"><i class="fas fa-plus me-1"></i>Nuevo</button>
    </div>

    <div class="card-custom">
        <div class="card-body-custom p-0">
            <div class="table-wrap">
                <table class="table-custom">
                    <thead><tr><th>ID</th><th>Titulo</th><th>Visible</th><th>Activo</th><th>Creado</th><th>Acciones</th></tr></thead>
                    <tbody id="tbAvisos"></tbody>
                </table>
            </div>
            <div class="pagination-wrap" id="dvPaginador"></div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalDetalleAviso" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fas fa-info-circle me-2" style="color:var(--primary);"></i>Detalle de Aviso</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid" id="dvDetalleAviso"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalEditarAviso" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fas fa-edit me-2" style="color:var(--primary);"></i><span id="lblAvisoTitulo">Nuevo Aviso</span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmAviso">
                    <input type="hidden" name="id" id="hdnAvisoId" value="0" />
                    <div class="form-grid-2">
                        <div class="form-group full-row">
                            <label>Titulo</label>
                            <input type="text" class="input-soft" name="titulo" id="txtTituloAviso" required />
                        </div>
                        <div class="form-group full-row">
                            <label>Descripcion</label>
                            <textarea class="input-soft" name="descripcion" id="txtDescripcionAviso" rows="3" required></textarea>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="pasajeros" id="chkAvisoPasajero" checked />
                                <span>Visible para Pasajeros</span>
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="conductores" id="chkAvisoConductor" checked />
                                <span>Visible para Conductores</span>
                            </label>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="activo" id="chkAvisoActivo" checked />
                                <span>Activo</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft primary" onclick="AvisosApp.guardar()"><i class="fas fa-save me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        var AvisosApp = (function () {
            var state = { pagina: 1, tamano: 20 };

            function cargar() {
                AdminApp.ajax('admin/ListarAvisos', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    renderTabla(data);
                });
            }

            function renderTabla(data) {
                var h = '';
                if (!data.length) { h = '<tr><td colspan="6"><div class="empty-state"><i class="fas fa-exclamation-triangle"></i><p>No hay avisos</p></div></td></tr>'; }
                else { data.forEach(function (r) {
                    var vis = [];
                    if (r.esavisopasajero === true || r.esavisopasajero === 1 || r.pasajeros === true) vis.push('Pasajeros');
                    if (r.esavisoconductor === true || r.esavisoconductor === 1 || r.conductores === true) vis.push('Conductores');
                    if (!vis.length) vis.push('--');
                    h += '<tr><td>' + AdminApp.getVal(r, 'id') + '</td><td>' + (AdminApp.getVal(r, 'tituloaviso') || AdminApp.getVal(r, 'titulo')) + '</td><td>' + vis.join(', ') + '</td><td>' + AdminApp.badge(r.activo === true || r.activo === 1) + '</td><td>' + AdminApp.fmtFecha(r.fechacreacion) + '</td><td class="accion-cell"><button class="view" title="Ver" onclick="AvisosApp.verDetalle(' + AdminApp.getVal(r, 'id') + ')"><i class="fas fa-eye"></i></button><button class="edit" title="Editar" onclick="AvisosApp.abrirEditar(' + AdminApp.getVal(r, 'id') + ')"><i class="fas fa-edit"></i></button><button class="del" title="Eliminar" onclick="AvisosApp.eliminar(' + AdminApp.getVal(r, 'id') + ')"><i class="fas fa-trash"></i></button></td></tr>';
                }); }
                $('#tbAvisos').html(h);
            }

            function abrirNuevo() {
                $('#lblAvisoTitulo').text('Nuevo Aviso');
                $('#hdnAvisoId').val(0);
                $('#frmAviso')[0].reset();
                $('#chkAvisoPasajero, #chkAvisoConductor, #chkAvisoActivo').prop('checked', true);
                AdminApp.openModal('modalEditarAviso');
            }

            function abrirEditar(id) {
                $('#lblAvisoTitulo').text('Editar Aviso');
                AdminApp.ajax('admin/ListarAvisos', 'GET', { pagina: 1, tamano: 500 }, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var item = data.find(function (x) { return (x.id || x.idAviso) == id; });
                    if (!item) { Toast.error('Aviso no encontrado'); return; }
                    $('#hdnAvisoId').val(item.id || item.idAviso);
                    $('#txtTituloAviso').val(AdminApp.getVal(item, 'tituloaviso') || AdminApp.getVal(item, 'titulo'));
                    $('#txtDescripcionAviso').val(AdminApp.getVal(item, 'descripcionaviso') || AdminApp.getVal(item, 'descripcion'));
                    $('#chkAvisoPasajero').prop('checked', item.esavisopasajero === true || item.esavisopasajero === 1 || item.pasajeros === true);
                    $('#chkAvisoConductor').prop('checked', item.esavisoconductor === true || item.esavisoconductor === 1 || item.conductores === true);
                    $('#chkAvisoActivo').prop('checked', item.activo === true || item.activo === 1);
                    AdminApp.openModal('modalEditarAviso');
                });
            }

            function guardar() {
                if (!$('#frmAviso')[0].checkValidity()) { $('#frmAviso')[0].reportValidity(); return; }
                var id = $('#hdnAvisoId').val();
                var obj = AdminApp.formToObj('frmAviso');
                var url = id > 0 && id !== '0' ? 'admin/EditarAviso' : 'admin/AgregarAviso';
                if (id > 0 && id !== '0') obj.id = id;
                AdminApp.ajax(url, 'POST', obj, function () {
                    Toast.success(id > 0 && id !== '0' ? 'Aviso actualizado' : 'Aviso creado');
                    AdminApp.closeModal('modalEditarAviso');
                    cargar();
                });
            }

            function eliminar(id) {
                AdminApp.confirm('Eliminar aviso', 'Esta seguro de eliminar este aviso?', function () {
                    AdminApp.ajax('admin/EliminarAviso', 'POST', { id: id }, function () {
                        Toast.success('Aviso eliminado');
                        cargar();
                    });
                });
            }

            function verDetalle(id) {
                AdminApp.ajax('admin/ListarAvisos', 'GET', { pagina: 1, tamano: 500 }, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var item = data.find(function (x) { return (x.id || x.idAviso) == id; });
                    if (!item) { Toast.error('Aviso no encontrado'); return; }
                    var h = '';
                    h += '<div class="detail-group"><span class="label">ID</span><span class="value">#' + AdminApp.getVal(item, 'id') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Titulo</span><span class="value">' + (AdminApp.getVal(item, 'tituloaviso') || AdminApp.getVal(item, 'titulo')) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Descripcion</span><span class="value">' + (AdminApp.getVal(item, 'descripcionaviso') || AdminApp.getVal(item, 'descripcion')) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Visible</span><span class="value">' + (item.esavisopasajero || item.esavisopasajero === 1 ? 'Pasajeros ' : '') + (item.esavisoconductor || item.esavisoconductor === 1 ? 'Conductores' : '') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Activo</span><span class="value">' + (item.activo ? 'Si' : 'No') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Creado</span><span class="value">' + AdminApp.fmtFecha(item.fechacreacion) + '</span></div>';
                    $('#dvDetalleAviso').html(h);
                    AdminApp.openModal('modalDetalleAviso');
                });
            }

            function init() { cargar(); }

            return { init: init, cargar: cargar, abrirNuevo: abrirNuevo, abrirEditar: abrirEditar, guardar: guardar, eliminar: eliminar, verDetalle: verDetalle };
        })();
        $(document).ready(function () { AvisosApp.init(); });
    </script>
}
