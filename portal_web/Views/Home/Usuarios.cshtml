@{
    ViewBag.Title = "Usuarios";
}

@section Styles {}

<div id="dvUsuarios">
    <div class="section-header">
        <h4><i class="fas fa-users me-2" style="color: var(--primary);"></i>Usuarios</h4>
        <button class="btn-soft" onclick="abrirModal()"><i class="fas fa-plus me-1"></i>Nuevo</button>
    </div>

    <div class="filters" id="dvFiltros">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" class="input-soft" id="txtBuscar" placeholder="Buscar usuario..." />
        </div>
        <select class="input-soft" id="selFiltroRol"><option value="">Todos los roles</option></select>
        <select class="input-soft" id="selFiltroActivo"><option value="">Todos</option><option value="true">Activos</option><option value="false">Inactivos</option></select>
        <button class="btn-soft outline" onclick="cargar()"><i class="fas fa-search me-1"></i>Buscar</button>
    </div>

    <div class="table-wrap" id="dvTabla"></div>

    <div class="pagination" id="dvPaginacion"></div>
</div>

<div class="modal fade" id="modalUsuario" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user me-2" style="color:var(--primary);"></i><span id="lblModalTitulo">Nuevo Usuario</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmUsuario">
                    <input type="hidden" name="idUsuario" id="hdnIdUsuario" value="0" />
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" class="input-soft" name="nombre" id="txtNombre" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Paterno</label>
                            <input type="text" class="input-soft" name="appaterno" id="txtAppaterno" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Materno</label>
                            <input type="text" class="input-soft" name="apmaterno" id="txtApmaterno" required />
                        </div>
                        <div class="form-group">
                            <label>Correo</label>
                            <input type="email" class="input-soft" name="correo" id="txtCorreo" required />
                        </div>
                        <div class="form-group">
                            <label>Teléfono</label>
                            <input type="tel" class="input-soft" name="telefono" id="txtTelefono" pattern="[0-9]{10}" maxlength="10" title="10 digitos" oninput="this.value=this.value.replace(/\D/g,'')" />
                        </div>
                        <div class="form-group">
                            <label>Account</label>
                            <input type="text" class="input-soft" name="account" id="txtAccount" required />
                        </div>
                        <div class="form-group" id="dvPass">
                            <label>Contraseña</label>
                            <input type="password" class="input-soft" name="pass" id="txtPass" minlength="6" />
                            <small class="text-muted" id="lblPassHelp">Dejar vacio para mantener la actual</small>
                        </div>
                        <div class="form-group">
                            <label>Sexo</label>
                            <select class="input-soft" name="sexo" id="selSexo" required>
                                <option value="">-- Seleccionar --</option>
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Rol</label>
                            <select class="input-soft" name="idRol" id="selRol" required></select>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="activo" id="chkActivo" checked />
                                <span>Activo</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft" onclick="guardar()"><i class="fas fa-save me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        $(function () {
            cargar();
            AdminApp.loadSelect('admin/ListarRoles','selRol','id','rolnombre');
            AdminApp.loadSelect('admin/ListarRoles','selFiltroRol','id','rolnombre');
            $('#txtBuscar').on('keyup',function(e){if(e.key==='Enter')cargar();});
        });

        function cargar(){
            AdminApp.ajax('admin/ListarUsuarios','GET',{
                pagina:AdminApp.state.pagina,tamano:AdminApp.state.tamano,
                busqueda:$('#txtBuscar').val(),idRol:$('#selFiltroRol').val(),activo:$('#selFiltroActivo').val()
            },function(r){var d=Array.isArray(r)?r:(r.data||[]);renderTable(d);renderPaginacion(r.totalRegistros||d.length);});
        }

        function renderTable(data){
            var h='<table class="table-custom"><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Account</th><th>Rol</th><th>Activo</th><th class="col-acciones">Acciones</th></tr></thead><tbody>';
            if(!data||!data.length)h+='<tr><td colspan="7"><div class="empty-state"><i class="fas fa-users"></i><h5>No hay usuarios</h5></div></td></tr>';
            else data.forEach(function(u){
                var id=AdminApp.getVal(u,'idUsuario')||AdminApp.getVal(u,'id');
                var nom=AdminApp.getVal(u,'Nombre'),ap=AdminApp.getVal(u,'appaterno'),am=AdminApp.getVal(u,'apmaterno');
                var activo=u.Activo!==undefined?u.Activo:(u.activo!==undefined?u.activo:true);
                h+='<tr><td><strong>#'+id+'</strong></td><td>'+nom+' '+ap+(am?' '+am:'')+'</td><td>'+AdminApp.getVal(u,'Correo','--')+'</td><td>'+AdminApp.getVal(u,'Account','--')+'</td><td>'+AdminApp.getVal(u,'NombreRol','--')+'</td><td>'+AdminApp.badge(activo)+'</td><td class="col-acciones"><button class="accion-btn" onclick="abrirModal('+id+')" title="Editar"><i class="fas fa-edit"></i></button><button class="accion-btn" onclick="AdminApp.confirm(\'Eliminar usuario\',\'Esta seguro de eliminar este usuario?\',function(){eliminar('+id+');})" title="Eliminar"><i class="fas fa-trash"></i></button></td></tr>';
            });
            h+='</tbody></table>';$('#dvTabla').html(h);
        }

        function renderPaginacion(total){
            var h=AdminApp.paginador(total,AdminApp.state.pagina,AdminApp.state.tamano,null);
            $('#dvPaginacion').html(h);
            $('#dvPaginacion .pages button').on('click',function(){AdminApp.state.pagina=parseInt($(this).data('p'));cargar();});
        }

        function abrirModal(id){
            AdminApp.closeModal('modalUsuario');$('#hdnIdUsuario').val(0);$('#lblModalTitulo').text('Nuevo Usuario');
            $('#frmUsuario')[0].reset();$('#chkActivo').prop('checked',true);$('#dvPass').show();$('#lblPassHelp').hide();$('#txtPass').prop('required',true);
            if(id){
                $('#lblModalTitulo').text('Editar Usuario');
                AdminApp.ajax('admin/ObtenerUsuario','GET',{idUsuario:id},function(u){
                    if(Array.isArray(u)) u=u[0]||{};
                    $('#hdnIdUsuario').val(u.IdUsuario||u.idUsuario||id);
                    $('#txtNombre').val(u.Nombre||u.nombre||'');
                    $('#txtAppaterno').val(u.ApellidoPaterno||u.appaterno||'');
                    $('#txtApmaterno').val(u.ApellidoMaterno||u.apmaterno||'');
                    $('#txtCorreo').val(u.Correo||u.correo||'');
                    $('#txtTelefono').val(u.Telefono||u.telefono||'');
                    $('#txtAccount').val(u.Account||u.account||'');
                    $('#selSexo').val(u.Sexo||u.sexo||'');
                    AdminApp.loadSelect('admin/ListarRoles','selRol','id','rolnombre',AdminApp.getVal(u,'idRol'));
                    var a=u.Activo!==undefined?u.Activo:(u.activo!==undefined?u.activo:true);
                    $('#chkActivo').prop('checked',a===true||a===1||a==='true');
                    $('#dvPass').show();$('#lblPassHelp').show();$('#txtPass').prop('required',false);
                });
            }
            AdminApp.openModal('modalUsuario');
        }

        function guardar(){
            if(!$('#frmUsuario')[0].checkValidity()){$('#frmUsuario')[0].reportValidity();return;}
            var obj=AdminApp.formToObj('frmUsuario'),id=parseInt($('#hdnIdUsuario').val());
            obj.idActualiza=parseInt(AdminApp.getUser().id||0);
            AdminApp.ajax(id>0?'admin/EditarUsuario':'admin/CrearUsuario','POST',obj,function(){
                AdminApp.closeModal('modalUsuario');
                AdminApp.Toast.success(id>0?'Usuario actualizado':'Usuario creado');
                cargar();
            });
        }

        function eliminar(id){
            AdminApp.ajax('admin/EliminarUsuario','POST',{idUsuario:id,idActualiza:AdminApp.getUser().id||1},function(){
                AdminApp.Toast.success('Usuario eliminado');cargar();
            });
        }
    </script>
}
