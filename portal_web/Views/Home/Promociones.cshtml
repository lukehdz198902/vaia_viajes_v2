@{
    ViewBag.Title = "Promociones";
}

@section Styles {
    <link href="~/css/pages/promociones.css?v=2" rel="stylesheet" />
}

<div class="list-page" id="dvPromociones">

    <header class="page-header">
        <div>
            <h2 class="page-header__title">Promociones</h2>
            <p class="page-header__subtitle">Campañas que se muestran como propaganda en la app del pasajero</p>
        </div>
        <div class="page-header__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="btnReloadPromos">
                <i class="fas fa-rotate"></i> Recargar
            </button>
            <button type="button" class="btn btn--primary btn--sm" id="btnNuevaPromo">
                <i class="fas fa-plus"></i> Nueva promocion
            </button>
        </div>
    </header>

    <div class="filter-bar" id="dvFiltros">
        <div class="form-field">
            <label class="form-label" for="txtBuscarPromo">Buscar</label>
            <div class="input-icon">
                <i class="fas fa-search input-icon__icon"></i>
                <input type="text" class="form-input" id="txtBuscarPromo" placeholder="Titulo o asunto..." />
            </div>
        </div>
        <div class="form-field">
            <label class="form-label" for="selEstadoPromo">Estado</label>
            <select class="form-select" id="selEstadoPromo">
                <option value="">Todos</option>
                <option value="VIGENTE">Vigentes</option>
                <option value="PROGRAMADA">Programadas</option>
                <option value="VENCIDA">Vencidas</option>
                <option value="INACTIVA">Inactivas</option>
            </select>
        </div>
        <div class="form-field">
            <label class="form-label" for="selActivoPromo">Activo</label>
            <select class="form-select" id="selActivoPromo">
                <option value="">Todos</option>
                <option value="1">Activas</option>
                <option value="0">Inactivas</option>
            </select>
        </div>
        <div class="filter-bar__actions">
            <button type="button" class="btn btn--ghost btn--sm" id="btnLimpiarFiltros">Limpiar</button>
            <button type="button" class="btn btn--primary btn--sm" id="btnBuscarPromo">
                <i class="fas fa-search"></i> Buscar
            </button>
        </div>
    </div>

    <div class="config-summary">
        <i class="fas fa-circle-info"></i>
        <span id="lblResumenPromos">Cargando...</span>
    </div>

    <div class="promo-grid" id="dvCards" aria-live="polite"></div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        window.VaiaPromos = (function () {
            var DATA = [];
            var state = { pagina: 1, tamano: 24 };

            var STATUS_MAP = {
                VIGENTE:    { cls: 'promo-status--vigente',    label: 'Vigente' },
                PROGRAMADA: { cls: 'promo-status--programada', label: 'Programada' },
                VENCIDA:    { cls: 'promo-status--vencida',    label: 'Vencida' },
                INACTIVA:   { cls: 'promo-status--inactiva',   label: 'Inactiva' }
            };

            function getVal(obj, key) {
                if (!obj || !key) return undefined;
                var k = key.toLowerCase();
                for (var p in obj) {
                    if (p.toLowerCase() === k) return obj[p];
                }
                return undefined;
            }

            function escapeHtml(s) {
                if (s == null) return '';
                return String(s).replace(/[&<>"']/g, function (m) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[m];
                });
            }

            function fmtDate(s) {
                if (!s) return '--';
                var d = new Date(s);
                if (isNaN(d)) return '--';
                return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function fmtDateTime(s) {
                if (!s) return '--';
                var d = new Date(s);
                if (isNaN(d)) return '--';
                return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' }) +
                       ' ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
            }

            function toLocalInput(s) {
                if (!s) return '';
                var d = new Date(s);
                if (isNaN(d)) return '';
                var pad = function (n) { return (n < 10 ? '0' : '') + n; };
                return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) +
                       'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
            }

            function cargar() {
                var $dvCards = $('#dvCards');
                $dvCards.html('<div class="skeleton skeleton--block" style="aspect-ratio:16/9;"></div>'.repeat(6));
                var activo = $('#selActivoPromo').val();
                var params = { pagina: state.pagina, tamano: state.tamano };
                if (activo === '0' || activo === '1') params.activo = activo === '1';
                AdminApp.ajax('admin/ListarPromociones', 'GET', params, function (res) {
                    var data = Array.isArray(res) ? res : (res && res.data ? res.data : []);
                    DATA = data.map(function (r) {
                        return {
                            id: getVal(r, 'id'),
                            titulo: getVal(r, 'titulo') || '(Sin titulo)',
                            asunto: getVal(r, 'asunto') || '',
                            img: getVal(r, 'img') || '',
                            inicio: getVal(r, 'inicio'),
                            fin: getVal(r, 'fin'),
                            activo: getVal(r, 'activo') === true || getVal(r, 'activo') === 1,
                            estado: getVal(r, 'estadovigencia') || 'INACTIVA'
                        };
                    });
                    render();
                }, function () {
                    $dvCards.html('<div class="empty-state"><div class="empty-state__icon"><i class="fas fa-triangle-exclamation"></i></div><h4 class="empty-state__title">No se pudieron cargar las promociones</h4><p class="empty-state__message">Verifica la conexion con el servidor e intenta de nuevo.</p></div>');
                    if (window.VaiaUI) window.VaiaUI.toast({ type: 'danger', title: 'Error', message: 'No se pudieron cargar las promociones' });
                });
            }

            function render() {
                var busqueda = $('#txtBuscarPromo').val().toLowerCase().trim();
                var estadoFiltro = $('#selEstadoPromo').val();
                var visibles = DATA.filter(function (r) {
                    if (estadoFiltro && r.estado !== estadoFiltro) return false;
                    if (busqueda) {
                        var t = (r.titulo + ' ' + r.asunto).toLowerCase();
                        if (t.indexOf(busqueda) < 0) return false;
                    }
                    return true;
                });

                $('#lblResumenPromos').text(visibles.length + ' promocion' + (visibles.length !== 1 ? 'es' : '') + ' (' + DATA.length + ' totales)');

                if (!visibles.length) {
                    $('#dvCards').html('<div class="empty-state" style="grid-column:1/-1;"><div class="empty-state__icon"><i class="fas fa-tags"></i></div><h4 class="empty-state__title">Sin promociones</h4><p class="empty-state__message">' + (busqueda ? 'No hay resultados para "' + escapeHtml(busqueda) + '".' : 'Crea tu primera promocion con el boton "+ Nueva promocion".') + '</p></div>');
                    return;
                }

                var html = '';
                visibles.forEach(function (r) {
                    var status = STATUS_MAP[r.estado] || STATUS_MAP.INACTIVA;
                    var preview = r.img ? '<img src="' + escapeHtml(r.img) + '" alt="' + escapeHtml(r.titulo) + '" loading="lazy">' : '<i class="fas fa-image promo-card__preview-placeholder"></i>';
                    html += '<article class="promo-card" data-id="' + r.id + '">';
                    html += '  <div class="promo-card__preview">' + preview + '<span class="promo-card__preview-status"><span class="promo-status ' + status.cls + '"><span class="dot"></span>' + status.label + '</span></span></div>';
                    html += '  <div class="promo-card__body">';
                    html += '    <h3 class="promo-card__title" title="' + escapeHtml(r.titulo) + '">' + escapeHtml(r.titulo) + '</h3>';
                    if (r.asunto) html += '  <p style="margin:0;font-size:var(--text-xs);color:var(--text-muted);-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;">' + escapeHtml(r.asunto) + '</p>';
                    html += '    <div class="promo-card__dates">';
                    html += '      <div><i class="fas fa-play" style="color:var(--accent);"></i> <strong>' + fmtDate(r.inicio) + '</strong></div>';
                    html += '      <div><i class="fas fa-stop" style="color:var(--state-danger);"></i> <strong>' + fmtDate(r.fin) + '</strong></div>';
                    html += '    </div>';
                    html += '  </div>';
                    html += '  <footer class="promo-card__footer">';
                    html += '    <span style="font-size:var(--text-xs);color:var(--text-muted);">' + (r.activo ? '<i class="fas fa-circle" style="color:var(--state-success);font-size:0.55rem;"></i> Activa' : '<i class="fas fa-circle" style="color:var(--text-soft);font-size:0.55rem;"></i> Inactiva') + '</span>';
                    html += '    <div class="promo-card__actions">';
                    html += '      <button type="button" class="btn btn--ghost btn--icon btn--sm" data-action="editar" data-id="' + r.id + '" title="Editar"><i class="fas fa-pen"></i></button>';
                    html += '      <button type="button" class="btn btn--ghost btn--icon btn--sm" data-action="eliminar" data-id="' + r.id + '" title="Eliminar"><i class="fas fa-trash"></i></button>';
                    html += '    </div>';
                    html += '  </footer>';
                    html += '</article>';
                });
                $('#dvCards').html(html);
            }

            function abrirEditor(id) {
                var item = id ? DATA.find(function (r) { return r.id == id; }) : null;
                var isNew = !item;

                var bodyHtml = '' +
                    '<input type="hidden" id="vaiaPromoId" value="' + (item ? item.id : '') + '">' +
                    '<div class="form-field" style="margin-bottom:var(--space-3);">' +
                    '  <label class="form-label" for="vaiaPromoTitulo">Titulo de la promocion <span class="required-mark">*</span></label>' +
                    '  <input type="text" class="form-input" id="vaiaPromoTitulo" value="' + escapeHtml(item ? item.titulo : '') + '" placeholder="Ej. 20% de descuento en tu primer viaje" />' +
                    '</div>' +
                    '<div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);margin-bottom:var(--space-3);">' +
                    '  <div class="form-field">' +
                    '    <label class="form-label" for="vaiaPromoInicio">Inicio de vigencia <span class="required-mark">*</span></label>' +
                    '    <input type="datetime-local" class="form-input" id="vaiaPromoInicio" value="' + (item ? toLocalInput(item.inicio) : '') + '" />' +
                    '  </div>' +
                    '  <div class="form-field">' +
                    '    <label class="form-label" for="vaiaPromoFin">Fin de vigencia <span class="required-mark">*</span></label>' +
                    '    <input type="datetime-local" class="form-input" id="vaiaPromoFin" value="' + (item ? toLocalInput(item.fin) : '') + '" />' +
                    '  </div>' +
                    '</div>' +
                    '<div class="form-field" style="margin-bottom:var(--space-3);">' +
                    '  <label class="form-label" for="vaiaPromoAsunto">Asunto / mensaje</label>' +
                    '  <textarea class="form-textarea" id="vaiaPromoAsunto" rows="3" placeholder="Texto que se enviara como propaganda...">' + escapeHtml(item ? item.asunto : '') + '</textarea>' +
                    '</div>' +
                    '<div class="form-field" style="margin-bottom:var(--space-3);">' +
                    '  <label class="form-label">Imagen</label>' +
                    '  <label class="promo-upload" for="vaiaPromoImgFile">' +
                    '    <div class="promo-upload__icon"><i class="fas fa-cloud-arrow-up"></i></div>' +
                    '    <div class="promo-upload__info">' +
                    '      <div class="promo-upload__title">Subir imagen</div>' +
                    '      <div class="promo-upload__hint">PNG, JPG hasta 2MB</div>' +
                    '    </div>' +
                    '    <input type="file" id="vaiaPromoImgFile" accept="image/*" />' +
                    '  </label>' +
                    '  <input type="hidden" id="vaiaPromoImg" value="' + escapeHtml(item ? item.img : '') + '" />' +
                    '  <div class="promo-upload-preview" id="vaiaPromoImgPreview"><img alt="Preview" /></div>' +
                    '</div>' +
                    '<div class="form-check">' +
                    '  <input type="checkbox" id="vaiaPromoActivo" ' + (isNew || item.activo ? 'checked' : '') + '>' +
                    '  <span>Promocion activa (visible en la app)</span>' +
                    '</div>';

                var m = window.VaiaUI.modal({
                    title: (isNew ? '<i class="fas fa-plus" style="color:var(--accent);margin-right:8px;"></i>Nueva promocion' : '<i class="fas fa-pen" style="color:var(--accent);margin-right:8px;"></i>Editar promocion'),
                    titleHtml: true,
                    body: bodyHtml,
                    fullscreen: true,
                    footer:
                        '<button type="button" class="btn btn--ghost" data-close>Cancelar</button>' +
                        '<button type="button" class="btn btn--primary" id="vaiaPromoGuardar"><i class="fas fa-save"></i> Guardar</button>'
                });

                var $imgPreview = $('#vaiaPromoImgPreview');
                var $imgHidden = $('#vaiaPromoImg');
                if (item && item.img) $imgPreview.show().find('img').attr('src', item.img);

                $('#vaiaPromoImgFile').on('change', function (e) {
                    var file = e.target.files[0];
                    if (!file) return;
                    if (file.size > 2 * 1024 * 1024) { window.VaiaUI.toast({ type: 'warning', title: 'Imagen muy grande', message: 'Maximo 2MB' }); return; }
                    var reader = new FileReader();
                    reader.onload = function (ev) {
                        var dataUrl = ev.target.result;
                        $imgHidden.val(dataUrl);
                        $imgPreview.show().find('img').attr('src', dataUrl);
                    };
                    reader.readAsDataURL(file);
                });

                $('#vaiaPromoGuardar').on('click', function () {
                    var data = {
                        titulo: $('#vaiaPromoTitulo').val().trim(),
                        inicio: $('#vaiaPromoInicio').val(),
                        fin: $('#vaiaPromoFin').val(),
                        asunto: $('#vaiaPromoAsunto').val(),
                        img: $('#vaiaPromoImg').val(),
                        activo: $('#vaiaPromoActivo').is(':checked')
                    };
                    if (!data.titulo) { window.VaiaUI.toast({ type: 'warning', title: 'Falta titulo', message: 'Ingresa un titulo' }); return; }
                    if (!data.inicio || !data.fin) { window.VaiaUI.toast({ type: 'warning', title: 'Fechas requeridas', message: 'Define inicio y fin de vigencia' }); return; }
                    if (new Date(data.inicio) >= new Date(data.fin)) { window.VaiaUI.toast({ type: 'warning', title: 'Fechas invalidas', message: 'El fin debe ser posterior al inicio' }); return; }

                    var idPromo = $('#vaiaPromoId').val();
                    if (idPromo) data.id = idPromo;

                    var url = idPromo ? 'admin/EditarPromocion' : 'admin/CrearPromocion';
                    AdminApp.ajax(url, 'POST', data, function () {
                        window.VaiaUI.toast({ type: 'success', title: 'Guardado', message: idPromo ? 'Promocion actualizada' : 'Promocion creada' });
                        m.close();
                        cargar();
                    });
                });
            }

            function eliminar(id) {
                var item = DATA.find(function (r) { return r.id == id; });
                if (!item) return;
                window.VaiaUI.confirm('Eliminar promocion', 'Se eliminara "' + item.titulo + '". Esta seguro?', function () {
                    AdminApp.ajax('admin/EliminarPromocion', 'POST', { id: id }, function () {
                        window.VaiaUI.toast({ type: 'success', title: 'Eliminado', message: 'Promocion eliminada' });
                        cargar();
                    });
                });
            }

            function initEventos() {
                $('#btnNuevaPromo').on('click', function () { abrirEditor(null); });
                $('#btnReloadPromos').on('click', cargar);
                $('#btnBuscarPromo').on('click', render);
                $('#btnLimpiarFiltros').on('click', function () {
                    $('#txtBuscarPromo').val('');
                    $('#selEstadoPromo').val('');
                    $('#selActivoPromo').val('');
                    render();
                });
                $('#txtBuscarPromo').on('input', render);
                $('#selEstadoPromo, #selActivoPromo').on('change', render);
                $('#dvCards').on('click', '[data-action]', function () {
                    var $b = $(this);
                    var id = $b.data('id');
                    if ($b.data('action') === 'editar') abrirEditor(id);
                    else if ($b.data('action') === 'eliminar') eliminar(id);
                });
            }

            return { init: function () { cargar(); initEventos(); } };
        })();

        $(document).ready(function () { window.VaiaPromos.init(); });
    </script>
}