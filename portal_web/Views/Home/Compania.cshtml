@{
    ViewBag.Title = "Compania";
}

@section Styles {
    <link href="~/css/admin.css" rel="stylesheet" />
    <style>
        .company-form { max-width:100%; }
        .company-form .form-grid { grid-template-columns:repeat(3,1fr); gap:12px; }
        .company-form .form-grid .form-group { margin-bottom:0; }
        .company-form .form-grid .form-group label { font-size:0.78rem; margin-bottom:3px; }
        .company-form .form-grid .form-group .input-soft { font-size:0.82rem; padding:6px 10px; min-height:auto; }
        .company-form hr { margin:14px 0; }
        .company-form .form-switch-custom { display: flex; align-items: center; gap: 10px; padding: 4px 0; }
        .company-form .form-switch-custom label { font-size: 0.88rem; font-weight: 500; color: var(--text-dark); cursor: pointer; }
        .company-form .form-switch-custom .switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
        .company-form .form-switch-custom .switch input { opacity: 0; width: 0; height: 0; }
        .company-form .form-switch-custom .switch .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: var(--border-color); border-radius: 24px; transition: var(--transition); }
        .company-form .form-switch-custom .switch .slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: var(--transition); }
        .company-form .form-switch-custom .switch input:checked + .slider { background: var(--primary); }
        .company-form .form-switch-custom .switch input:checked + .slider:before { transform: translateX(20px); }
        .company-form .opts-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; }
    </style>
}

<div id="dvCompania">
    <div class="section-header">
        <h4><i class="fas fa-building"></i> Compania</h4>
        <button class="btn-soft primary" onclick="Compania.guardar()"><i class="fas fa-save"></i> Guardar Cambios</button>
    </div>

    <div class="card-custom company-form">
        <div class="card-body-custom">
            <input type="hidden" id="txtCompaniaId" />

            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre de la Compania</label>
                    <input type="text" class="input-soft" id="txtCompaniaNombre" name="nombre" />
                </div>
                <div class="form-group">
                    <label>Km a la Redonda Mas Cercanos</label>
                    <input type="number" step="any" class="input-soft" id="txtKmRedonda" name="kms" />
                </div>
                <div class="form-group">
                    <label>Seg Espera Toma Servicio</label>
                    <input type="number" class="input-soft" id="txtSegEsperaToma" name="segTomar" />
                </div>
                <div class="form-group">
                    <label>Seg Espera Salga Pasajero</label>
                    <input type="number" class="input-soft" id="txtSegEsperaSalga" name="segEspera" />
                </div>
                <div class="form-group">
                    <label>No. Unidades Mas Cercanas (max 5)</label>
                    <input type="number" min="1" max="5" class="input-soft" id="txtNoUnidades" name="numUnidades" />
                </div>
                <div class="form-group">
                    <label>Min para Pago PayPal</label>
                    <input type="number" step="any" class="input-soft" id="txtMinPaypal" name="minPP" />
                </div>
                <div class="form-group">
                    <label>Min para Pago MercadoPago</label>
                    <input type="number" step="any" class="input-soft" id="txtMinMp" name="minMP" />
                </div>
                <div class="form-group">
                    <label>Version Pasajero Android</label>
                    <input type="text" class="input-soft" id="txtVersionPasajero" name="verPasajero" />
                </div>
                <div class="form-group">
                    <label>Version Conductor Android</label>
                    <input type="text" class="input-soft" id="txtVersionConductor" name="verConductor" />
                </div>
            </div>

            <hr />
            <h6 class="mb-3"><i class="fas fa-toggle-on me-2" style="color:var(--primary);"></i>Opciones</h6>
            <div class="opts-grid">
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkPagoTarjeta" name="tarjetaAct" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkPagoTarjeta">Pago con Tarjeta Activo</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkSoloUnidad" name="soloCercana" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkSoloUnidad">Solo la Unidad Mas Cercana</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkPaypal" name="paypalAct" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkPaypal">PayPal Activo</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkMercadoPago" name="mpAct" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkMercadoPago">MercadoPago Activo</label>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        var Compania = (function () {
            function cargar() {
                AdminApp.ajax('admin/ListarCompanias', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var item = data.length ? data[0] : null;
                    if (!item) { Toast.warning('No hay compania registrada'); return; }
                    $('#txtCompaniaId').val(item.id || item.idCompania);
                    $('#txtCompaniaNombre').val(item.companianombre||'');
                    $('#txtKmRedonda').val(item.kmsalaredondamascercanos||'');
                    $('#txtSegEsperaToma').val(item.segesperatomaservicio||'');
                    $('#txtSegEsperaSalga').val(item.segesperasalgapasajero||'');
                    $('#txtNoUnidades').val(item.nounidadesmascercanas||'');
                    $('#txtMinPaypal').val(item.minsparapagopaypal||'');
                    $('#txtMinMp').val(item.minsparapagomercadopago||'');
                    $('#txtVersionPasajero').val(item.versionpasajeroandroid||'');
                    $('#txtVersionConductor').val(item.versionconductorandroid||'');
                    $('#chkPagoTarjeta').prop('checked',item.pagocontarjetaactivo===true||item.pagocontarjetaactivo===1);
                    $('#chkSoloUnidad').prop('checked',item.sololaunidadmascercana===true||item.sololaunidadmascercana===1);
                    $('#chkPaypal').prop('checked',item.paypalactivo===true||item.paypalactivo===1);
                    $('#chkMercadoPago').prop('checked',item.mercadopagoactivo===true||item.mercadopagoactivo===1);
                });
            }

            function guardar() {
                if(!$('#dvCompania')[0].querySelector('[name]')){ return; }
                var id = $('#txtCompaniaId').val();
                if (!id) { Toast.warning('No hay compania para actualizar'); return; }
                var data = AdminApp.formToObj('dvCompania');
                data.id = id;
                AdminApp.ajax('admin/ActualizarCompania', 'POST', data, function () {
                    Toast.success('Compania actualizada');
                    cargar();
                });
            }

            function init() { cargar(); }

            return { init: init, cargar: cargar, guardar: guardar };
        })();
        $(document).ready(function () { Compania.init(); });
    </script>
}
