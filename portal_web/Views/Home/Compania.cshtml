@{
    ViewBag.Title = "Compania";
}

@section Styles {
    <link href="~/Content/css/admin.css" rel="stylesheet" />
    <style>
        .company-form { max-width: 900px; }
        .form-switch-custom { display: flex; align-items: center; gap: 10px; padding: 8px 0; }
        .form-switch-custom label { font-size: 0.88rem; font-weight: 500; color: var(--text-dark); cursor: pointer; }
        .form-switch-custom .switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
        .form-switch-custom .switch input { opacity: 0; width: 0; height: 0; }
        .form-switch-custom .switch .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background: var(--border-color); border-radius: 24px; transition: var(--transition); }
        .form-switch-custom .switch .slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: var(--transition); }
        .form-switch-custom .switch input:checked + .slider { background: var(--primary); }
        .form-switch-custom .switch input:checked + .slider:before { transform: translateX(20px); }
    </style>
}

<div id="dvCompania">
    <div class="section-header">
        <h4><i class="fas fa-building"></i> Compania</h4>
        <button class="btn-soft primary" onclick="Compania.guardar()"><i class="fas fa-save"></i> Guardar Cambios</button>
    </div>

    <div class="card-custom company-form">
        <div class="card-body-custom">
            <input type="hidden" id="txtCompaniaId" />

            <div class="form-grid">
                <div class="form-group">
                    <label>Nombre de la Compania</label>
                    <input type="text" class="input-soft" id="txtCompaniaNombre" name="companianombre" />
                </div>
                <div class="form-group">
                    <label>Km a la Redonda Mas Cercanos</label>
                    <input type="number" step="any" class="input-soft" id="txtKmRedonda" name="kmsalaredondamascercanos" />
                </div>
                <div class="form-group">
                    <label>Seg Espera Toma Servicio</label>
                    <input type="number" class="input-soft" id="txtSegEsperaToma" name="segesperatomaservicio" />
                </div>
                <div class="form-group">
                    <label>Seg Espera Salga Pasajero</label>
                    <input type="number" class="input-soft" id="txtSegEsperaSalga" name="segesperasalgapasajero" />
                </div>
                <div class="form-group">
                    <label>No. Unidades Mas Cercanas</label>
                    <input type="number" class="input-soft" id="txtNoUnidades" name="nounidadesmascercanas" />
                </div>
                <div class="form-group">
                    <label>Min para Pago PayPal</label>
                    <input type="number" step="any" class="input-soft" id="txtMinPaypal" name="minsparapagopaypal" />
                </div>
                <div class="form-group">
                    <label>Min para Pago MercadoPago</label>
                    <input type="number" step="any" class="input-soft" id="txtMinMp" name="minsparapagomercadopago" />
                </div>
                <div class="form-group">
                    <label>Version Pasajero Android</label>
                    <input type="text" class="input-soft" id="txtVersionPasajero" name="versionpasajeroandroid" />
                </div>
                <div class="form-group">
                    <label>Version Conductor Android</label>
                    <input type="text" class="input-soft" id="txtVersionConductor" name="versionconductorandroid" />
                </div>
            </div>

            <hr />
            <h6 class="mb-3"><i class="fas fa-toggle-on me-2" style="color:var(--primary);"></i>Opciones</h6>
            <div class="form-grid">
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkPagoTarjeta" name="pagocontarjetaactivo" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkPagoTarjeta">Pago con Tarjeta Activo</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkSoloUnidad" name="sololaunidadmascercana" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkSoloUnidad">Solo la Unidad Mas Cercana</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkPaypal" name="paypalactivo" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkPaypal">PayPal Activo</label>
                </div>
                <div class="form-switch-custom">
                    <label class="switch">
                        <input type="checkbox" id="chkMercadoPago" name="mercadopagoactivo" />
                        <span class="slider"></span>
                    </label>
                    <label for="chkMercadoPago">MercadoPago Activo</label>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        var Compania = (function () {
            function cargar() {
                AdminApp.ajax('admin/ListarCompanias', 'GET', null, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var item = data.length ? data[0] : null;
                    if (!item) { Toast.warning('No hay compania registrada'); return; }
                    $('#txtCompaniaId').val(item.id || item.idCompania);
                    AdminApp.objToForm('dvCompania', item);
                });
            }

            function guardar() {
                var id = $('#txtCompaniaId').val();
                if (!id) { Toast.warning('No hay compania para actualizar'); return; }
                var data = AdminApp.formToObj('dvCompania');
                data.id = id;
                AdminApp.ajax('admin/ActualizarCompania', 'POST', data, function () {
                    Toast.success('Compania actualizada');
                    cargar();
                });
            }

            function init() { cargar(); }

            return { init: init, cargar: cargar, guardar: guardar };
        })();
        $(document).ready(function () { Compania.init(); });
    </script>
}
