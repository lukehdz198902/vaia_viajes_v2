@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaia Viajes - Iniciar Sesion</title>
    <link rel="icon" type="image/svg+xml" href="https://cdn-icons-png.flaticon.com/512/3095/3095583.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('vaia-theme');
                var theme = (stored === 'light' || stored === 'dark')
                    ? stored
                    : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) { document.documentElement.setAttribute('data-theme', 'light'); }
        })();
    </script>
    <link href="~/css/tokens.css?v=2" rel="stylesheet" />
    <link href="~/css/base.css?v=2" rel="stylesheet" />
    <link href="~/css/animations.css?v=2" rel="stylesheet" />
    <link href="~/css/components.css?v=2" rel="stylesheet" />
    <link href="~/css/layout.css?v=2" rel="stylesheet" />
    <link href="~/css/responsive.css?v=2" rel="stylesheet" />
    <link href="~/css/pages/login.css?v=2" rel="stylesheet" />
</head>
<body class="login-page">
    <button type="button" class="theme-toggle theme-toggle--floating" data-vaia-theme-toggle aria-label="Cambiar tema" aria-pressed="false" title="Cambiar tema">
        <i class="fas fa-moon" data-theme-icon></i>
    </button>

    <div class="login-bg" aria-hidden="true">
        <div class="bubble bubble--1"></div>
        <div class="bubble bubble--2"></div>
        <div class="bubble bubble--3"></div>
        <div class="bubble bubble--4"></div>
        <div class="bubble bubble--5"></div>
    </div>

    <main class="login-card" role="main">
        <header class="login-header">
            <div class="login-logo" aria-hidden="true">
                <i class="fas fa-car-side"></i>
            </div>
            <h1 class="login-title">Vaia Viajes</h1>
            <p class="login-subtitle">Portal Administrativo</p>
        </header>

        <form id="frmLogin" class="login-form" autocomplete="on" novalidate>
            <div class="login-error" id="dvError" role="alert" aria-live="polite"></div>

            <div class="login-field">
                <input type="text" class="login-input" id="txtAccount" name="account"
                       placeholder="Usuario o correo" autocomplete="username" autofocus
                       aria-label="Usuario" required />
                <i class="fas fa-user login-input-icon" aria-hidden="true"></i>
            </div>

            <div class="login-field">
                <input type="password" class="login-input" id="txtPass" name="pass"
                       placeholder="Contrasena" autocomplete="current-password"
                       aria-label="Contrasena" required />
                <i class="fas fa-lock login-input-icon" aria-hidden="true"></i>
                <button type="button" class="pass-toggle" id="btnTogglePass" tabindex="-1" aria-label="Mostrar contrasena">
                    <i class="fas fa-eye"></i>
                </button>
            </div>

            <div class="login-actions">
                <button type="submit" class="login-btn" id="btnLogin">
                    <span class="btn-label">Ingresar</span>
                    <span class="btn-spinner" id="spinnerBtn" aria-hidden="true"></span>
                </button>
            </div>
        </form>

        <footer class="login-footer">
            <small>&copy; 2026 Vaia Viajes. Todos los derechos reservados.</small>
        </footer>
    </main>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/core/vaia-theme.js"></script>
    @Html.Partial("_VaiaConfig")
    <script src="~/Scripts/Login/login.js"></script>
</body>
</html>