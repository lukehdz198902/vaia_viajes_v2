@{
    ViewBag.Title = "Pasajeros";
}

@section Styles {
    <link href="~/Content/section.css" rel="stylesheet" />
}

<div id="dvPasajeros">
    <div class="section-header">
        <h4><i class="fas fa-user-friends me-2" style="color: var(--primary);"></i>Pasajeros</h4>
        <button class="btn-soft" onclick="abrirModal()"><i class="fas fa-plus me-1"></i>Nuevo</button>
    </div>

    <div class="filters" id="dvFiltros">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" class="input-soft" id="txtBuscar" placeholder="Buscar pasajero..." />
        </div>
        <select class="input-soft" id="selFiltroBloqueado"><option value="">Todos</option><option value="true">Bloqueados</option><option value="false">Activos</option></select>
        <button class="btn-soft outline" onclick="cargar()"><i class="fas fa-search me-1"></i>Buscar</button>
    </div>

    <div class="table-wrap" id="dvTabla"></div>

    <div class="pagination" id="dvPaginacion"></div>
</div>

<div class="modal fade" id="modalPasajero" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-friends me-2" style="color:var(--primary);"></i><span id="lblModalTitulo">Nuevo Pasajero</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmPasajero">
                    <input type="hidden" name="idPasajero" id="hdnIdPasajero" value="0" />
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" class="input-soft" name="nombre" id="txtNombre" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Paterno</label>
                            <input type="text" class="input-soft" name="appaterno" id="txtAppaterno" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Materno</label>
                            <input type="text" class="input-soft" name="apmaterno" id="txtApmaterno" />
                        </div>
                        <div class="form-group">
                            <label>Correo</label>
                            <input type="email" class="input-soft" name="correo" id="txtCorreo" required />
                        </div>
                        <div class="form-group">
                            <label>Teléfono</label>
                            <input type="text" class="input-soft" name="telefono" id="txtTelefono" />
                        </div>
                        <div class="form-group">
                            <label>Fecha de Nacimiento</label>
                            <input type="date" class="input-soft" name="fechanacimiento" id="txtFechanacimiento" />
                        </div>
                        <div class="form-group">
                            <label>Género</label>
                            <select class="input-soft" name="genero" id="selGenero">
                                <option value="">-- Seleccionar --</option>
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Notas Adicionales</label>
                            <textarea class="input-soft" name="notasadicionales" id="txtNotasadicionales" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="activo" id="chkActivo" checked />
                                <span>Activo</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft" onclick="guardar()"><i class="fas fa-save me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetallePasajero" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user me-2" style="color:var(--primary);"></i>Detalle del Pasajero</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid" id="dvDetallePasajero"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        $(function () {
            cargar();
            $('#txtBuscar').on('keyup', function (e) { if (e.key === 'Enter') cargar(); });
        });

        function cargar() {
            var data = {
                pagina: AdminApp.state.pagina,
                tamano: AdminApp.state.tamano,
                busqueda: $('#txtBuscar').val(),
                bloqueado: $('#selFiltroBloqueado').val()
            };
            AdminApp.ajax('admin/ListarPasajeros', 'GET', data, function (res) {
                var dataArr = Array.isArray(res) ? res : (res.data || []);
                renderTable(dataArr);
                renderPaginacion(res.totalRegistros || dataArr.length);
            });
        }

        function renderTable(data) {
            var h = '<table class="table-custom"><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Account</th><th>Viajes</th><th>Bloqueado</th><th class="col-acciones">Acciones</th></tr></thead><tbody>';
            if (!data || data.length === 0) {
                h += '<tr><td colspan="8"><div class="empty-state"><i class="fas fa-user-friends"></i><h5>No hay pasajeros</h5></div></td></tr>';
            } else {
                data.forEach(function (p) {
                    var id = p.IdPasajero || p.idPasajero || 0;
                    var nom = p.Nombre || p.nombre || '';
                    var ap = p.ApellidoPaterno || p.appaterno || '';
                    var am = p.ApellidoMaterno || p.apmaterno || '';
                    var nombreCompleto = nom + ' ' + ap + (am ? ' ' + am : '');
                    var correo = p.Correo || p.correo || '--';
                    var telefono = p.Telefono || p.telefono || '--';
                    var account = p.Account || p.account || '--';
                    var viajes = p.Viajes || p.viajes || p.TotalViajes || p.totalViajes || 0;
                    var bloqueado = p.Bloqueado !== undefined ? p.Bloqueado : (p.bloqueado !== undefined ? p.bloqueado : false);
                    h += '<tr>';
                    h += '<td><strong>#' + id + '</strong></td>';
                    h += '<td>' + nombreCompleto + '</td>';
                    h += '<td>' + correo + '</td>';
                    h += '<td>' + telefono + '</td>';
                    h += '<td>' + account + '</td>';
                    h += '<td>' + viajes + '</td>';
                    h += '<td>' + AdminApp.badge(bloqueado, 'Bloqueado', 'Normal', 'inactive', 'active') + '</td>';
                    h += '<td class="col-acciones">';
                    h += '<button class="accion-btn" onclick="verDetalle(' + id + ')" title="Ver"><i class="fas fa-eye"></i></button>';
                    h += '<button class="accion-btn" onclick="abrirModal(' + id + ')" title="Editar"><i class="fas fa-edit"></i></button>';
                    h += '<button class="accion-btn" onclick="toggleBloqueo(' + id + ',' + bloqueado + ')" title="' + (bloqueado ? 'Desbloquear' : 'Bloquear') + '"><i class="fas ' + (bloqueado ? 'fa-unlock' : 'fa-ban') + '"></i></button>';
                    h += '</td></tr>';
                });
            }
            h += '</tbody></table>';
            $('#dvTabla').html(h);
        }

        function renderPaginacion(total) {
            var h = AdminApp.paginador(total, AdminApp.state.pagina, AdminApp.state.tamano, null);
            $('#dvPaginacion').html(h);
            $('#dvPaginacion .pages button').on('click', function () {
                AdminApp.state.pagina = parseInt($(this).data('p'));
                cargar();
            });
        }

        function abrirModal(id) {
            AdminApp.closeModal('modalPasajero');
            $('#hdnIdPasajero').val(0);
            $('#lblModalTitulo').text('Nuevo Pasajero');
            $('#frmPasajero')[0].reset();
            $('#chkActivo').prop('checked', true);
            if (id) {
                $('#lblModalTitulo').text('Editar Pasajero');
                AdminApp.ajax('admin/ObtenerPasajero', 'GET', { idPasajero: id }, function (p) {
                    $('#hdnIdPasajero').val(p.IdPasajero || p.idPasajero);
                    AdminApp.objToForm('frmPasajero', p);
                });
            }
            AdminApp.openModal('modalPasajero');
        }

        function guardar() {
            var obj = AdminApp.formToObj('frmPasajero');
            var id = parseInt($('#hdnIdPasajero').val());
            AdminApp.ajax('admin/ActualizarPasajero', 'POST', obj, function (res) {
                AdminApp.closeModal('modalPasajero');
                AdminApp.Toast.success('Pasajero actualizado');
                cargar();
            });
        }

        function verDetalle(id) {
            AdminApp.ajax('admin/ObtenerPasajero', 'GET', { idPasajero: id }, function (p) {
                var h = '<div class="detail-row"><span class="label">ID</span><span>' + (p.IdPasajero || p.idPasajero) + '</span></div>';
                h += '<div class="detail-row"><span class="label">Nombre</span><span>' + (p.Nombre || p.nombre) + ' ' + (p.ApellidoPaterno || p.appaterno) + ' ' + (p.ApellidoMaterno || p.apmaterno || '') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Correo</span><span>' + (p.Correo || p.correo || '--') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Teléfono</span><span>' + (p.Telefono || p.telefono || '--') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Account</span><span>' + (p.Account || p.account || '--') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Género</span><span>' + (p.Genero || p.genero || '--') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Fecha Nac.</span><span>' + AdminApp.fmtFecha(p.FechaNacimiento || p.fechanacimiento) + '</span></div>';
                h += '<div class="detail-row"><span class="label">Notas</span><span>' + (p.NotasAdicionales || p.notasadicionales || '--') + '</span></div>';
                h += '<div class="detail-row"><span class="label">Estatus</span><span>' + AdminApp.badge(!(p.Bloqueado || p.bloqueado)) + '</span></div>';
                $('#dvDetallePasajero').html(h);
                AdminApp.openModal('modalDetallePasajero');
            });
        }

        function toggleBloqueo(id, estadoActual) {
            var nuevoEstado = !estadoActual;
            var msg = nuevoEstado ? '¿Bloquear este pasajero?' : '¿Desbloquear este pasajero?';
            if (!confirm(msg)) return;
            AdminApp.ajax('admin/SuspenderPasajero', 'POST', { idPasajero: id, bloqueado: nuevoEstado, motivo: nuevoEstado ? 'Bloqueo administrativo' : '' }, function (res) {
                AdminApp.Toast.success(nuevoEstado ? 'Pasajero bloqueado' : 'Pasajero desbloqueado');
                cargar();
            });
        }
    </script>
}
