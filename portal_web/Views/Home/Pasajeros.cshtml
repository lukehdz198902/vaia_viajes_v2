@{
    ViewBag.Title = "Pasajeros";
}

@section Styles {}

<div id="dvPasajeros">
    <div class="section-header">
        <h4><i class="fas fa-user-friends me-2" style="color: var(--primary);"></i>Pasajeros</h4>
        <button class="btn-soft" onclick="abrirModal()"><i class="fas fa-plus me-1"></i>Nuevo</button>
    </div>

    <div class="filters" id="dvFiltros">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" class="input-soft" id="txtBuscar" placeholder="Buscar pasajero..." />
        </div>
        <select class="input-soft" id="selFiltroBloqueado"><option value="">Todos</option><option value="true">Bloqueados</option><option value="false">Activos</option></select>
        <button class="btn-soft outline" onclick="cargar()"><i class="fas fa-search me-1"></i>Buscar</button>
    </div>

    <div class="table-wrap" id="dvTabla"></div>

    <div class="pagination" id="dvPaginacion"></div>
</div>

<div class="modal fade" id="modalPasajero" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-friends me-2" style="color:var(--primary);"></i><span id="lblModalTitulo">Nuevo Pasajero</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmPasajero">
                    <input type="hidden" name="idPasajero" id="hdnIdPasajero" value="0" />
                    <div class="form-grid-2">
                        <div class="form-group">
                            <label>Nombre</label>
                            <input type="text" class="input-soft" name="nombre" id="txtNombre" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Paterno</label>
                            <input type="text" class="input-soft" name="appaterno" id="txtAppaterno" required />
                        </div>
                        <div class="form-group">
                            <label>Apellido Materno</label>
                            <input type="text" class="input-soft" name="apmaterno" id="txtApmaterno" />
                        </div>
                        <div class="form-group">
                            <label>Correo</label>
                            <input type="email" class="input-soft" name="correo" id="txtCorreo" required />
                        </div>
                        <div class="form-group">
                            <label>Teléfono</label>
                            <input type="tel" class="input-soft" name="telefono" id="txtTelefono" pattern="[0-9]{10}" maxlength="10" title="10 digitos" oninput="this.value=this.value.replace(/\D/g,'')" />
                        </div>
                        <div class="form-group">
                            <label>Fecha de Nacimiento</label>
                            <input type="date" class="input-soft" name="fechanacimiento" id="txtFechanacimiento" />
                        </div>
                        <div class="form-group">
                            <label>Género</label>
                            <select class="input-soft" name="genero" id="selGenero">
                                <option value="">-- Seleccionar --</option>
                                <option value="M">Masculino</option>
                                <option value="F">Femenino</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Notas Adicionales</label>
                            <textarea class="input-soft" name="notasadicionales" id="txtNotasadicionales" rows="2"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="activo" id="chkActivo" checked />
                                <span>Activo</span>
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft" onclick="guardar()"><i class="fas fa-save me-1"></i>Guardar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetallePasajero" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user me-2" style="color:var(--primary);"></i>Detalle del Pasajero</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid" id="dvDetallePasajero"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        $(function () { cargar(); $('#txtBuscar').on('keyup', function (e) { if (e.key === 'Enter') cargar(); }); });

        function fmtTel(t) { if (!t || t.length!==10) return t||'--'; return t.substring(0,3)+'-'+t.substring(3,6)+'-'+t.substring(6); }

        function cargar() {
            AdminApp.ajax('admin/ListarPasajeros','GET',{
                pagina:AdminApp.state.pagina,tamano:AdminApp.state.tamano,
                busqueda:$('#txtBuscar').val(),bloqueado:$('#selFiltroBloqueado').val()
            },function(r){ var d=Array.isArray(r)?r:(r.data||[]); renderTable(d); renderPaginacion(r.totalRegistros||d.length); });
        }

        function renderTable(data) {
            var h='<table class="table-custom"><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Telefono</th><th>Account</th><th>Viajes</th><th>Bloqueado</th><th class="col-acciones">Acciones</th></tr></thead><tbody>';
            if(!data||!data.length) h+='<tr><td colspan="8"><div class="empty-state"><i class="fas fa-user-friends"></i><h5>No hay pasajeros</h5></div></td></tr>';
            else data.forEach(function(p){
                var id=AdminApp.getVal(p,'idPasajero')||AdminApp.getVal(p,'id');
                var nom=AdminApp.getVal(p,'Nombre'),ap=AdminApp.getVal(p,'appaterno'),am=AdminApp.getVal(p,'apmaterno');
                var tel=fmtTel(AdminApp.getVal(p,'Telefono'));
                var blq=p.Bloqueado===true||p.bloqueado===true||p.Bloqueado===1;
                h+='<tr><td><strong>#'+id+'</strong></td><td>'+nom+' '+ap+(am?' '+am:'')+'</td><td>'+AdminApp.getVal(p,'Correo','--')+'</td><td>'+tel+'</td><td>'+AdminApp.getVal(p,'Account','--')+'</td><td>'+AdminApp.safeNum(AdminApp.getVal(p,'TotalViajes'))+'</td><td>'+AdminApp.badge(blq,'Bloqueado','Normal','inactive','active')+'</td><td class="col-acciones"><button class="accion-btn" onclick="verDetalle('+id+')" title="Ver"><i class="fas fa-eye"></i></button><button class="accion-btn" onclick="abrirModal('+id+')" title="Editar"><i class="fas fa-edit"></i></button><button class="accion-btn" onclick="AdminApp.confirm(\''+(blq?'Desbloquear':'Bloquear')+' pasajero\',\'Esta seguro de '+(blq?'desbloquear':'bloquear')+' este pasajero?\',function(){ toggleBloqueo('+id+','+blq+'); })" title="'+(blq?'Desbloquear':'Bloquear')+'"><i class="fas '+(blq?'fa-unlock':'fa-ban')+'"></i></button></td></tr>';
            });
            h+='</tbody></table>'; $('#dvTabla').html(h);
        }

        function renderPaginacion(total) {
            var h=AdminApp.paginador(total,AdminApp.state.pagina,AdminApp.state.tamano,null);
            $('#dvPaginacion').html(h);
            $('#dvPaginacion .pages button').on('click',function(){ AdminApp.state.pagina=parseInt($(this).data('p')); cargar(); });
        }

        function abrirModal(id) {
            AdminApp.closeModal('modalPasajero'); $('#hdnIdPasajero').val(0); $('#lblModalTitulo').text('Nuevo Pasajero');
            $('#frmPasajero')[0].reset(); $('#chkActivo').prop('checked',true);
            if(id){
                $('#lblModalTitulo').text('Editar Pasajero');
                AdminApp.ajax('admin/ObtenerPasajero','GET',{idPasajero:id},function(res){
                    var p=AdminApp.unwrapSingle(res)||{};
                    $('#hdnIdPasajero').val(p.IdPasajero||p.idPasajero||id);
                    $('#txtNombre').val(p.Nombre||p.nombre||'');
                    $('#txtAppaterno').val(p.ApellidoPaterno||p.appaterno||'');
                    $('#txtApmaterno').val(p.ApellidoMaterno||p.apmaterno||'');
                    $('#txtCorreo').val(p.Correo||p.correo||'');
                    $('#txtTelefono').val(p.Telefono||p.telefono||'');
                    var fn=p.FechaNacimiento||p.fechanacimiento||'';
                    $('#txtFechanacimiento').val(fn?fn.substring(0,10):'');
                    $('#selGenero').val(p.Genero||p.genero||'');
                    $('#txtNotasadicionales').val(p.NotasAdicionales||p.notasadicionales||'');
                    var act=p.Activo!==undefined?p.Activo:p.activo;
                    $('#chkActivo').prop('checked',act!==undefined?(act===true||act===1||act==='true'):true);
                });
            }
            AdminApp.openModal('modalPasajero');
        }

        function guardar() {
            if(!$('#frmPasajero')[0].checkValidity()){ $('#frmPasajero')[0].reportValidity(); return; }
            var obj=AdminApp.formToObj('frmPasajero'), id=parseInt($('#hdnIdPasajero').val());
            obj.idActualiza=parseInt(AdminApp.getUser().id||0);
            AdminApp.ajax(id>0?'admin/ActualizarPasajero':'admin/CrearPasajero','POST',obj,function(){
                AdminApp.closeModal('modalPasajero');
                AdminApp.Toast.success(id>0?'Pasajero actualizado':'Pasajero creado');
                cargar();
            });
        }

        function toggleBloqueo(id,estadoActual) {
            var n=!estadoActual;
            AdminApp.ajax('admin/SuspenderPasajero','POST',{idPasajero:id,bloqueado:n,motivo:n?'Bloqueo administrativo':''},function(){
                AdminApp.Toast.success(n?'Pasajero bloqueado':'Pasajero desbloqueado'); cargar();
            });
        }
    </script>
}
