@{
    ViewBag.Title = "Cortes Semanales";
}

@section Styles {
    <link href="~/css/admin.css" rel="stylesheet" />
}

<div id="dvCortes">
    <div class="section-header">
        <h4><i class="fas fa-calendar-week"></i> Cortes Semanales</h4>
        <div class="d-flex gap-2 align-items-center">
            <div class="search-box" style="width:220px;">
                <i class="fas fa-search"></i>
                <input type="text" class="input-soft" id="txtBuscarConductor" placeholder="Buscar conductor..." onkeyup="if(event.key==='Enter') CortesApp.cargar()" />
            </div>
            <button class="btn-soft primary" onclick="CortesApp.abrirProcesar()"><i class="fas fa-play me-1"></i>Procesar</button>
        </div>
    </div>

    <div class="card-custom">
        <div class="card-body-custom p-0">
            <div class="table-wrap">
                <table class="table-custom">
                    <thead><tr><th>ID</th><th>Conductor</th><th>Semana</th><th>Total Viajes</th><th>Total Ingresos</th><th>Comision</th><th>Procesado</th><th>Acciones</th></tr></thead>
                    <tbody id="tbCortes"></tbody>
                </table>
            </div>
            <div class="pagination-wrap" id="dvPaginador"></div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalDetalleCorte" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fas fa-info-circle me-2" style="color:var(--primary);"></i>Detalle de Corte</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="detail-grid" id="dvDetalleCorte"></div>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-soft" id="modalProcesar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="fas fa-play me-2" style="color:var(--primary);"></i>Procesar Corte Semanal</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="frmProcesar">
                    <div class="form-group">
                        <label>Conductor <small>(opcional, vacio = todos)</small></label>
                        <select class="input-soft" id="selConductorProcesar" name="idConductor">
                            <option value="">-- Todos los conductores --</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn-soft outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn-soft primary" onclick="CortesApp.procesar()"><i class="fas fa-play me-1"></i>Procesar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/admin.js"></script>
    <script>
        var CortesApp = (function () {
            var state = { pagina: 1, tamano: 20 };

            function cargar() {
                var busqueda = $('#txtBuscarConductor').val();
                AdminApp.ajax('admin/ListarSemanasCorte', 'GET', { pagina: state.pagina, tamano: state.tamano, idConductor: busqueda || null }, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var total = res.totalregistros || res.total || data.length;
                    renderTabla(data);
                    $('#dvPaginador').html(AdminApp.paginador(total, state.pagina, state.tamano, function (p) { state.pagina = p; cargar(); }));
                });
            }

            function renderTabla(data) {
                var h = '';
                if (!data.length) { h = '<tr><td colspan="8"><div class="empty-state"><i class="fas fa-calendar-week"></i><p>No hay cortes</p></div></td></tr>'; }
                else { data.forEach(function (r) {
                    h += '<tr><td>' + AdminApp.getVal(r, 'id') + '</td><td>' + (AdminApp.getVal(r, 'conductor') || AdminApp.getVal(r, 'nombreConductor') || '--') + '</td><td>' + AdminApp.getVal(r, 'semana') + '</td><td>' + AdminApp.safeNum(AdminApp.getVal(r, 'totalViajes')) + '</td><td>' + AdminApp.fmtMoneda(r.totalIngresos || r.ingresos) + '</td><td>' + AdminApp.fmtMoneda(r.comision) + '</td><td>' + AdminApp.badge(r.procesado === true || r.procesado === 1) + '</td><td class="accion-cell"><button class="view" title="Ver" onclick="CortesApp.verDetalle(' + AdminApp.getVal(r, 'id') + ')"><i class="fas fa-eye"></i></button></td></tr>';
                }); }
                $('#tbCortes').html(h);
            }

            function abrirProcesar() {
                AdminApp.loadSelect('admin/ListarRazonesSocialesConductores', 'selConductorProcesar', 'id', 'nombre', null, true);
                AdminApp.openModal('modalProcesar');
            }

            function procesar() {
                var idConductor = $('#selConductorProcesar').val();
                AdminApp.ajax('admin/ProcesarSemanaCorte', 'POST', { idConductor: idConductor || null }, function () {
                    Toast.success('Corte procesado');
                    AdminApp.closeModal('modalProcesar');
                    cargar();
                });
            }

            function verDetalle(id) {
                AdminApp.ajax('admin/ListarSemanasCorte', 'GET', { pagina: 1, tamano: 500 }, function (res) {
                    var data = Array.isArray(res) ? res : (res.data || []);
                    var item = data.find(function (x) { return (x.id || x.idCorte) == id; });
                    if (!item) { Toast.error('Corte no encontrado'); return; }
                    var h = '';
                    h += '<div class="detail-group"><span class="label">ID</span><span class="value">#' + AdminApp.getVal(item, 'id') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Conductor</span><span class="value">' + (AdminApp.getVal(item, 'conductor') || AdminApp.getVal(item, 'nombreConductor') || '--') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Semana</span><span class="value">' + AdminApp.getVal(item, 'semana') + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Total Viajes</span><span class="value">' + AdminApp.safeNum(AdminApp.getVal(item, 'totalViajes')) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Total Ingresos</span><span class="value">' + AdminApp.fmtMoneda(item.totalIngresos || item.ingresos) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Comision</span><span class="value">' + AdminApp.fmtMoneda(item.comision) + '</span></div>';
                    h += '<div class="detail-group"><span class="label">Procesado</span><span class="value">' + (item.procesado ? 'Si' : 'No') + '</span></div>';
                    $('#dvDetalleCorte').html(h);
                    AdminApp.openModal('modalDetalleCorte');
                });
            }

            function init() { cargar(); }

            return { init: init, cargar: cargar, abrirProcesar: abrirProcesar, procesar: procesar, verDetalle: verDetalle };
        })();
        $(document).ready(function () { CortesApp.init(); });
    </script>
}
